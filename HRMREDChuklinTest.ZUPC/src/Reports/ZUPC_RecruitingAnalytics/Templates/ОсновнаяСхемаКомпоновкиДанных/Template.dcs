		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ZUPC_НовыеCотрудники.СотрудникСтрока КАК Name,
	ZUPC_НовыеCотрудники.ДатаВыхода КАК StartDate,
	ZUPC_НовыеCотрудники.ActualDepartmentName КАК Department,
	ZUPC_НовыеCотрудники.Руководитель КАК DepartmentHead,
	ZUPC_НовыеCотрудники.Город КАК Location,
	ZUPC_НовыеCотрудники.SearchSource КАК SearchSource,
	ZUPC_НовыеCотрудники.AgencyName КАК Agency,
	ZUPC_НовыеCотрудники.AgentFee КАК AgencyCost,
	ZUPC_НовыеCотрудники.Referree КАК Referree,
	ZUPC_НовыеCотрудники.Сотрудник КАК Сотрудник
ИЗ
	РегистрСведений.ZUPC_НовыеCотрудники КАК ZUPC_НовыеCотрудники
{ГДЕ
	(ZUPC_НовыеCотрудники.ДатаВыхода МЕЖДУ &amp;ДатаВыходаНачало И &amp;ДатаВыходаОкончание)}</query>
