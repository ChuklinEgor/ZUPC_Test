<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>EmployeeName</dataPath>
			<field>EmployeeName</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Employee name</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Position</dataPath>
			<field>Position</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Position</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Perimeter</dataPath>
			<field>Perimeter</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Perimeter</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Location</dataPath>
			<field>Location</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Location</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>JoiningDate</dataPath>
			<field>JoiningDate</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Joining date</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Спеллинг</dataPath>
			<field>Спеллинг</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Спеллинг</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ActualDepartmentName</dataPath>
			<field>ActualDepartmentName</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Actual department name</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Desk_Team</dataPath>
			<field>Desk_Team</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Desk team</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПриемНаРаботу.Сотрудник КАК EmployeeName,
	ПриемНаРаботу.Сотрудник.ZUPC_ActualPositionTitle КАК Position,
	ПриемНаРаботу.ДатаПриема КАК JoiningDate,
	ПриемНаРаботу.Организация.ZUPC_Perimeter КАК Perimeter,
	ПриемНаРаботу.Сотрудник.ZUPC_Locations КАК Location,
	ПриемНаРаботу.Ссылка КАК Ссылка,
	ВЫБОР
		КОГДА ПриемНаРаботу.Сотрудник.Спеллинг &lt;&gt; ""
			ТОГДА ПриемНаРаботу.Сотрудник.Спеллинг
		ИНАЧЕ ПриемНаРаботу.Сотрудник
	КОНЕЦ КАК Спеллинг,
	ПриемНаРаботу.Организация КАК Организация,
	ПриемНаРаботу.Сотрудник.ZUPC_ActualDepartmentName КАК ActualDepartmentName,
	ПриемНаРаботу.Сотрудник.ZUPC_Desk_Team КАК Desk_Team
ИЗ
	Документ.ПриемНаРаботу КАК ПриемНаРаботу
ГДЕ
	НЕ ПриемНаРаботу.ПометкаУдаления
	И ПриемНаРаботу.Проведен
	И ПриемНаРаботу.Дата МЕЖДУ &amp;ДатаН И &amp;ДатаК
	И НЕ ПриемНаРаботу.ZUPC_PersonnelRelocation</query>
	</dataSet>
