		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВТРаботающиеСотрудникиНачалоПериода.Сотрудник КАК Сотрудник,
	1 КАК ЗначениеПоказателя,
	"Beginning Headcount" КАК Показатель,
	ИСТИНА КАК Месячный,
	1 КАК Приоритет
ИЗ
	ВТРаботающиеСотрудникиНачалоПериода КАК ВТРаботающиеСотрудникиНачалоПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТРаботающиеСотрудникиКонецПериода.Сотрудник,
	1,
	"Ending Headcount",
	ИСТИНА,
	5
ИЗ
	ВТРаботающиеСотрудникиКонецПериода КАК ВТРаботающиеСотрудникиКонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТПринятыеЗаМесяц.Сотрудник,
	1,
	"Hired",
	ИСТИНА,
	3
ИЗ
	ВТПринятыеЗаМесяц КАК ВТПринятыеЗаМесяц

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТУволенныеЗаМесяц.Сотрудник,
	1,
	"Resigned",
	ИСТИНА,
	4
ИЗ
	ВТУволенныеЗаМесяц КАК ВТУволенныеЗаМесяц

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяССылка),
	(ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоМесяца + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2,
	"Average Monthly Headcount",
	ИСТИНА,
	2
ИЗ
	ВТДанныеДляРасчетаЧисленности КАК ВТДанныеДляРасчетаЧисленности

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка),
	ВЫБОР
		КОГДА (ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоМесяца + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2 = 0
			ТОГДА 0
		ИНАЧЕ ВТДанныеДляРасчетаЧисленности.УволенныеЗаМесяц / ((ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоМесяца + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2) * 100
	КОНЕЦ,
	"Turnover Rate",
	ИСТИНА,
	6
ИЗ
	ВТДанныеДляРасчетаЧисленности КАК ВТДанныеДляРасчетаЧисленности

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТРаботающиеСотрудникиКонецПериода.Сотрудник,
	1,
	"Headcount, Full Time Employees (FTE)",
	ЛОЖЬ,
	2
ИЗ
	ВТРаботающиеСотрудникиКонецПериода КАК ВТРаботающиеСотрудникиКонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТРаботающиеСотрудникиНачалоГода.Сотрудник,
	1,
	"Beginning year Headcount",
	ЛОЖЬ,
	1
ИЗ
	ВТРаботающиеСотрудникиНачалоГода КАК ВТРаботающиеСотрудникиНачалоГода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТПринятыеСНачалаГода.Сотрудник,
	1,
	"Hired YTD, FTE",
	ЛОЖЬ,
	4
ИЗ
	ВТПринятыеСНачалаГода КАК ВТПринятыеСНачалаГода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТПринятыеЗаМесяц.Сотрудник,
	1,
	СТРЗАМЕНИТЬ("Hired in Mounth,FTE", "Mounth", &amp;ОтчетныйМесяц) КАК Показатель,
	ЛОЖЬ,
	5
ИЗ
	ВТПринятыеЗаМесяц КАК ВТПринятыеЗаМесяц

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТУволенныеСНачалаГода.Сотрудник,
	1,
	"Resigned, FTE",
	ЛОЖЬ,
	6
ИЗ
	ВТУволенныеСНачалаГода КАК ВТУволенныеСНачалаГода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТУволенныеСНачалаГода.Сотрудник,
	1,
	"Resigned as Co initiative , FTE",
	ЛОЖЬ,
	7
ИЗ
	ВТУволенныеСНачалаГода КАК ВТУволенныеСНачалаГода
ГДЕ
	ВТУволенныеСНачалаГода.ПриказОбУвольнении.ZUPC_ReasonForTermination = ЗНАЧЕНИЕ(Перечисление.ZUPC_ReasonForTermination.ZUPC_ResignedAsCoInitiative)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТУволенныеСНачалаГода.Сотрудник,
	1,
	"Resigned at their own will, FTE",
	ЛОЖЬ,
	8
ИЗ
	ВТУволенныеСНачалаГода КАК ВТУволенныеСНачалаГода
ГДЕ
	ВТУволенныеСНачалаГода.ПриказОбУвольнении.ZUPC_ReasonForTermination = ЗНАЧЕНИЕ(Перечисление.ZUPC_ReasonForTermination.ZUPCResignedAtTheirOwnWill)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяССылка),
	(ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоГода + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2,
	"Average Headcount, FTE",
	ЛОЖЬ,
	3
ИЗ
	ВтДанныеДляРасчетаЧисленности КАК ВТДанныеДляРасчетаЧисленности

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяССылка),
	ВЫБОР
		КОГДА (ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоГода + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2 = 0
			ТОГДА 0
		ИНАЧЕ (ВТДанныеДляРасчетаЧисленности.УволенныеПоСобственномуЖеланию / ((ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоГода + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2)) * 100
	КОНЕЦ,
	"Voluntary Turnover",
	ЛОЖЬ,
	9
ИЗ
	ВТДанныеДляРасчетаЧисленности КАК ВТДанныеДляРасчетаЧисленности

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяССылка),
	ВЫБОР
		КОГДА (ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоГода + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2 = 0
			ТОГДА 0
		ИНАЧЕ (ВТДанныеДляРасчетаЧисленности.УволенныеСНачалаГода / ((ВТДанныеДляРасчетаЧисленности.РаботающиеНаНачалоГода + ВТДанныеДляРасчетаЧисленности.РаботающиеНаКонецМесяца) / 2)) * 100
	КОНЕЦ,
	"Total Turnover",
	ЛОЖЬ,
	10
ИЗ
	ВТДанныеДляРасчетаЧисленности КАК ВТДанныеДляРасчетаЧисленности</query>
	</dataSet>
	<totalField>
		<dataPath>ЗначениеПоказателя</dataPath>
		<expression>isNULL(Сумма(isnull(ЗначениеПоказателя,0)),0)</expression>
	</totalField>
	<parameter>
		<name>Организация</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Организация</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Организации</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ПриказОбУвольнении</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Приказ об увольнении</v8:content>
			</v8:item>
		</title>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
	<parameter>
		<name>ОтчетныйМесяц</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отчетный месяц</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:string</v8:Type>
			<v8:StringQualifiers>
				<v8:Length>0</v8:Length>
				<v8:AllowedLength>Variable</v8:AllowedLength>
			</v8:StringQualifiers>
		</valueType>
		<value xsi:type="xs:string"/>
		<useRestriction>true</useRestriction>
		<expression>ФОРМАТ(&amp;Период.ДатаОкончания, "ДФ=ММММ")</expression>
	</parameter>
	<template>
		<name>Макет1</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell>
					<dcsat:item xsi:type="dcsat:Field">
						<dcsat:value xsi:type="v8:LocalStringType">
							<v8:item>
								<v8:lang>ru</v8:lang>
								<v8:content>№</v8:content>
							</v8:item>
						</dcsat:value>
						<dcsat:appearance>
							<dcscor:item>
								<dcscor:parameter>Формат</dcscor:parameter>
								<dcscor:value xsi:type="xs:string">ДФ='ММММ гг'; ДЛФ=DD</dcscor:value>
							</dcscor:item>
						</dcsat:appearance>
					</dcsat:item>
					<dcsat:appearance>
						<dcscor:item>
							<dcscor:parameter>ЦветФона</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Color">#5B9BD5</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>ЦветГраницы</dcscor:parameter>
							<dcscor:value xmlns:d8p1="http://v8.1c.ru/8.1/data/ui/style" xsi:type="v8ui:Color">d8p1:FieldTextColor</dcscor:value>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>СтильГраницы</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Line" width="0" gap="false">
								<v8ui:style xsi:type="v8ui:SpreadsheetDocumentCellLineType">None</v8ui:style>
							</dcscor:value>
							<dcscor:item>
								<dcscor:parameter>СтильГраницы.Слева</dcscor:parameter>
								<dcscor:value xsi:type="v8ui:Line" width="1" gap="false">
									<v8ui:style xsi:type="v8ui:SpreadsheetDocumentCellLineType">Solid</v8ui:style>
								</dcscor:value>
							</dcscor:item>
							<dcscor:item>
								<dcscor:parameter>СтильГраницы.Сверху</dcscor:parameter>
								<dcscor:value xsi:type="v8ui:Line" width="1" gap="false">
									<v8ui:style xsi:type="v8ui:SpreadsheetDocumentCellLineType">Solid</v8ui:style>
								</dcscor:value>
							</dcscor:item>
							<dcscor:item>
								<dcscor:parameter>СтильГраницы.Справа</dcscor:parameter>
								<dcscor:value xsi:type="v8ui:Line" width="1" gap="false">
									<v8ui:style xsi:type="v8ui:SpreadsheetDocumentCellLineType">Solid</v8ui:style>
								</dcscor:value>
							</dcscor:item>
							<dcscor:item>
								<dcscor:parameter>СтильГраницы.Снизу</dcscor:parameter>
								<dcscor:value xsi:type="v8ui:Line" width="1" gap="false">
									<v8ui:style xsi:type="v8ui:SpreadsheetDocumentCellLineType">Solid</v8ui:style>
								</dcscor:value>
							</dcscor:item>
						</dcscor:item>
						<dcscor:item>
							<dcscor:parameter>Шрифт</dcscor:parameter>
							<dcscor:value xsi:type="v8ui:Font" faceName="Arial" height="8" bold="true" italic="false" underline="false" strikeout="false" kind="Absolute" scale="100"/>
