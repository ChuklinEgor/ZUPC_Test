
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

СтандартнаяОбработка = Ложь;	
	
МВТ = Новый МенеджерВременныхТаблиц;

Период = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Значение;

Если КонецМесяца(Период.ДатаНачала) <> Период.ДатаОкончания Тогда 
	Период.ДатаОкончания = КонецМесяца(Период.ДатаНачала);
	ОбщегоНазначения.СообщитьПользователю("Изменена дата кончания периода. Отчет может формироваться только помесячно");
КонецЕсли;

Организация = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение;
ПодготовитьВременныеТаблицыДляОтчета(МВТ, Организация ,Период);

КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.ПолучитьНастройки(), ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанных"));

// Здесь его используем
ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;

ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,, ДанныеРасшифровки, Истина,,МВТ);

ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);

КонецПроцедуры

Процедура ПодготовитьВременныеТаблицыДляОтчета(МВТ,Организация ,Период)
	
	ПараметрыПолучения = КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоСпискуФизическихЛиц();
	ПараметрыПолучения.Организация = Организация;
	
	РаботающиеСотрудникиНаДату(МВТ, Период.ДатаНачала,    "ВТРаботающиеСотрудникиНачалоПериода",ПараметрыПолучения);	
	РаботающиеСотрудникиНаДату(МВТ, Период.ДатаОкончания, "ВТРаботающиеСотрудникиКонецПериода", ПараметрыПолучения);
	РаботающиеСотрудникиНаДату(МВТ, НачалоГода(Период.ДатаНачала), "ВТРаботающиеСотрудникиНачалоГода", ПараметрыПолучения);
		
	СобытиеПрием = Перечисления.ВидыКадровыхСобытий.Прием;
	СобытиеУвольнение = Перечисления.ВидыКадровыхСобытий.Увольнение;
	
	КадровыеСобытияЗаПериод(МВТ, Период.ДатаНачала, Период.ДатаОкончания, СобытиеПрием, "ВТПринятыеЗаМесяц",ПараметрыПолучения);
	КадровыеСобытияЗаПериод(МВТ, Период.ДатаНачала, Период.ДатаОкончания, СобытиеУвольнение, "ВТУволенныеЗаМесяц",ПараметрыПолучения);   	
	КадровыеСобытияЗаПериод(МВТ, НачалоГода(Период.ДатаНачала), Период.ДатаОкончания, СобытиеПрием, "ВТПринятыеСНачалаГода",ПараметрыПолучения);
	КадровыеСобытияЗаПериод(МВТ, НачалоГода(Период.ДатаНачала), Период.ДатаОкончания, СобытиеУвольнение, "ВТУволенныеСНачалаГода",ПараметрыПолучения); 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТРаботающиеСотрудникиНачалоПериода.Сотрудник) КАК РаботающиеНаНачалоМесяца,
	               |	0 КАК РаботающиеНаКонецМесяца,
	               |	0 КАК РаботающиеНаНачалоГода,
	               |	0 КАК ПринятыеЗаМесяц,
	               |	0 КАК УволенныеЗаМесяц,
	               |	0 КАК ПринятыеСНачалаГода,
	               |	0 КАК УволенныеСНачалаГода,
	               |	0 КАК УволенныеПоСобственномуЖеланию,
	               |	0 КАК УволенныеПоИнициативеРаботодателя
	               |ПОМЕСТИТЬ ВТДанные
	               |ИЗ
	               |	ВТРаботающиеСотрудникиНачалоПериода КАК ВТРаботающиеСотрудникиНачалоПериода
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	0,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТРаботающиеСотрудникиКонецПериода.Сотрудник),
	               |	0,
	               |	0,
	               |	0,
