Процедура РаботающиеСотрудникиНаДату(МВТ,ДатаСведений, ИмяВременнойТаблицы, Знач ПараметрыПолучения)
	
ПараметрыПолучения.НачалоПериода = ДатаСведений;
ПараметрыПолучения.ОкончаниеПериода = ДатаСведений;
	
КадровыйУчет.СоздатьВТСотрудникиОрганизации(МВТ , Истина, ПараметрыПолучения,ИмяВременнойТаблицы);
	
КонецПроцедуры	

Процедура КадровыеСобытияЗаПериод(МВТ,НачалоПериода, ОкончанияПериода, КадровоеСобытие, ИмяВременнойТаблицы, Знач ПараметрыПолучения)
	
	ПараметрыПолучения.Отборы = Новый Массив();
	
	ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,"ВидСобытия", "=",КадровоеСобытие);
	
	Если КадровоеСобытие = Перечисления.ВидыКадровыхСобытий.Прием Тогда	
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,"ДатаПриема", ">=",НачалоПериода);
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,"ДатаПриема", "<=",ОкончанияПериода);
	Иначе
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,"ДатаУвольнения", ">=",НачалоПериода);
		ЗарплатаКадрыОбщиеНаборыДанных.ДобавитьВКоллекциюОтбор(ПараметрыПолучения.Отборы,"ДатаУвольнения", "<=",ОкончанияПериода);	
	КонецЕсли;	
	
	ПараметрыПолучения.КадровыеДанные = "ДатаПриема, ДатаУвольнения, ВидСобытия, ПриказОбУвольнении";

	ПараметрыПолучения.НачалоПериода = НачалоПериода;
    ПараметрыПолучения.ОкончаниеПериода = ОкончанияПериода;

	КадровыйУчет.СоздатьВТСотрудникиОрганизации(МВТ , Истина, ПараметрыПолучения,ИмяВременнойТаблицы);

КонецПроцедуры

