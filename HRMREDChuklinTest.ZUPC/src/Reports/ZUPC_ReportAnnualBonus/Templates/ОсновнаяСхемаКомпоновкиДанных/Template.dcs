		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DateJoingGroup</dataPath>
			<field>DateJoingGroup</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Date joing group</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Спеллинг</dataPath>
			<field>Спеллинг</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Спеллинг</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ZUPC_AnnualBonus.ФизическоеЛицо КАК ФизическоеЛицо,
	ZUPC_AnnualBonus.ГодБонуса КАК ГодБонуса,
	ZUPC_AnnualBonus.Оклад КАК Оклад,
	ZUPC_AnnualBonus.КоличествоОкладов КАК КоличествоОкладов,
	ZUPC_AnnualBonus.Прората КАК Прората,
	ZUPC_AnnualBonus.СуммаБонуса КАК СуммаБонуса,
	ZUPC_AnnualBonus.БонусВОффере КАК БонусВОффере,
	ZUPC_AnnualBonus.Комментарий КАК Комментарий,
	ZUPC_AnnualBonus.ФизическоеЛицо.ZUPC_DateJoingGroup КАК DateJoingGroup,
	ZUPC_AnnualBonus.ФизическоеЛицо.ZUPC_Спеллинг КАК Спеллинг
ИЗ
	РегистрСведений.ZUPC_AnnualBonus КАК ZUPC_AnnualBonus</query>
	</dataSet>
