<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сотрудник</dataPath>
			<field>Сотрудник</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Организация</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФизическоеЛицо</dataPath>
			<field>ФизическоеЛицо</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ГоловнаяОрганизация</dataPath>
			<field>ГоловнаяОрганизация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Валюта</dataPath>
			<field>Валюта</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Год</dataPath>
			<field>Год</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОкончания</dataPath>
			<field>ДатаОкончания</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПриема</dataPath>
			<field>ДатаПриема</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Position</dataPath>
			<field>Position</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Position</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Department</dataPath>
			<field>Department</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Department</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Desk_Team</dataPath>
			<field>Desk_Team</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Desk team</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Location</dataPath>
			<field>Location</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Location</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Зарплата_net</dataPath>
			<field>Зарплата_net</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Зарплата net</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Курс</dataPath>
			<field>Курс</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>DateJoingGroup</dataPath>
			<field>DateJoingGroup</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Date joing group</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Спеллинг</dataPath>
			<field>Спеллинг</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Спеллинг</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФОТ</dataPath>
			<field>ФОТ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Курс1</dataPath>
			<field>Курс1</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Курс1</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SalaryUSD</dataPath>
			<field>SalaryUSD</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Salary USD</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОсновноеНачисление</dataPath>
			<field>ОсновноеНачисление</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>SalaryUSDNet</dataPath>
			<field>SalaryUSDNet</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Salary USDNet</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Приоритет</dataPath>
			<field>Приоритет</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Приоритет</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаРождения</dataPath>
			<field>ДатаРождения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата рождения</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	МАКСИМУМ(ПлановыйФОТИтогиСрезПоследних.Период) КАК Период,
	ПлановыйФОТИтогиСрезПоследних.Сотрудник КАК Сотрудник,
	ПлановыйФОТИтогиСрезПоследних.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	ПлановыйФОТИтогиСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо
ПОМЕСТИТЬ ВТМакс_Период
ИЗ
	РегистрСведений.ПлановыйФОТИтоги.СрезПоследних КАК ПлановыйФОТИтогиСрезПоследних

СГРУППИРОВАТЬ ПО
	ПлановыйФОТИтогиСрезПоследних.Сотрудник,
	ПлановыйФОТИтогиСрезПоследних.ГоловнаяОрганизация,
	ПлановыйФОТИтогиСрезПоследних.ФизическоеЛицо
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПлановыйФОТИтогиСрезПоследних.Период КАК Период,
	ПлановыйФОТИтогиСрезПоследних.Сотрудник КАК Сотрудник,
	ПлановыйФОТИтогиСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	ПлановыйФОТИтогиСрезПоследних.Год КАК Год,
	ПлановыйФОТИтогиСрезПоследних.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	ПлановыйФОТИтогиСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
	ПлановыйФОТИтогиСрезПоследних.ОсновноеНачисление КАК ОсновноеНачисление,
	ПлановыйФОТИтогиСрезПоследних.ВидТарифнойСтавки КАК ВидТарифнойСтавки,
	ПлановыйФОТИтогиСрезПоследних.ТарифнаяСтавка КАК ТарифнаяСтавка,
	ПлановыйФОТИтогиСрезПоследних.СовокупнаяТарифнаяСтавка КАК СовокупнаяТарифнаяСтавка,
	ПлановыйФОТИтогиСрезПоследних.ФОТ КАК ФОТ,
	ПлановыйФОТИтогиСрезПоследних.Надбавка КАК Надбавка,
	ПлановыйФОТИтогиСрезПоследних.Используется КАК Используется,
	ПлановыйФОТИтогиСрезПоследних.ПоказательТарифнойСтавки КАК ПоказательТарифнойСтавки,
	ПлановыйФОТИтогиСрезПоследних.РегистраторСобытия КАК РегистраторСобытия,
	ПлановыйФОТИтогиСрезПоследних.ПериодПредыдущейЗаписи КАК ПериодПредыдущейЗаписи,
	ZUPC_ВалютаВидаНачисления.Валюта КАК Валюта
ПОМЕСТИТЬ ВТ_ФОТ
ИЗ
	ВТМакс_Период КАК ВТМакс_Период
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыйФОТИтоги.СрезПоследних КАК ПлановыйФОТИтогиСрезПоследних
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ZUPC_ВалютаВидаНачисления КАК ZUPC_ВалютаВидаНачисления
			ПО ПлановыйФОТИтогиСрезПоследних.ОсновноеНачисление = ZUPC_ВалютаВидаНачисления.ВидНачисления
		ПО ВТМакс_Период.Сотрудник = ПлановыйФОТИтогиСрезПоследних.Сотрудник
			И ВТМакс_Период.ГоловнаяОрганизация = ПлановыйФОТИтогиСрезПоследних.ГоловнаяОрганизация
			И ВТМакс_Период.ФизическоеЛицо = ПлановыйФОТИтогиСрезПоследних.ФизическоеЛицо
			И ВТМакс_Период.Период = ПлановыйФОТИтогиСрезПоследних.Период
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Увольнение.Сотрудник КАК Сотрудник
ПОМЕСТИТЬ ВТУволенныеВЭтомМесяце
ИЗ
	Документ.Увольнение КАК Увольнение
ГДЕ
	НЕ Увольнение.ПометкаУдаления
	И Увольнение.Проведен
	И Увольнение.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ТекДата, МЕСЯЦ) И КОНЕЦПЕРИОДА(&amp;ТекДата, МЕСЯЦ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК Организация,
	ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
	1 КАК Количество,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_ActualPositionTitle КАК Position,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_ActualDepartmentName КАК Department,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_Desk_Team КАК Desk_Team,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_Locations КАК Location,
	ВЫБОР
		КОГДА ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net &gt; 0
			ТОГДА ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net
		ИНАЧЕ ВТ_ФОТ.ФОТ
	КОНЕЦ КАК Зарплата_net,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.ZUPC_DateJoingGroup КАК DateJoingGroup,
	ВЫБОР
		КОГДА ТекущиеКадровыеДанныеСотрудников.Сотрудник.Спеллинг &lt;&gt; ""
			ТОГДА ТекущиеКадровыеДанныеСотрудников.Сотрудник.Спеллинг
		ИНАЧЕ ТекущиеКадровыеДанныеСотрудников.Сотрудник
	КОНЕЦ КАК Спеллинг,
	ВТ_ФОТ.ФОТ КАК ФОТ,
	КурсыВалютСрезПоследнихLocal.Курс КАК Курс,
	КурсыВалютСрезПоследнихUSD.Курс КАК Курс1,
	ВЫБОР
		КОГДА ВТ_ФОТ.ОсновноеНачисление.Наименование &lt;&gt; "Оплата по окладу"
			ТОГДА ВЫРАЗИТЬ(КурсыВалютСрезПоследнихLocal.Курс * ВТ_ФОТ.ФОТ / КурсыВалютСрезПоследнихUSD.Курс КАК ЧИСЛО(15, 0))
		ИНАЧЕ ВЫРАЗИТЬ(ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net / КурсыВалютСрезПоследнихUSD.Курс КАК ЧИСЛО(15, 0))
	КОНЕЦ КАК SalaryUSD,
	ВТ_ФОТ.ОсновноеНачисление КАК ОсновноеНачисление,
	ВЫРАЗИТЬ(ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net / КурсыВалютСрезПоследнихUSD.Курс КАК ЧИСЛО(15, 0)) КАК SalaryUSDNet,
	ЕСТЬNULL(ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_ActualDepartmentName.Приоритет, 0) КАК Приоритет,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.ДатаРождения КАК ДатаРождения
ПОМЕСТИТЬ ВТУвВЭМес
ИЗ
	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ZUPC_ЗарплатаNet.СрезПоследних КАК ZUPC_ЗарплатаNetСрезПоследних
		ПО ТекущиеКадровыеДанныеСотрудников.Сотрудник = ZUPC_ЗарплатаNetСрезПоследних.Сотрудник
			И ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = ZUPC_ЗарплатаNetСрезПоследних.ФизическоеЛицо
			И ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = ZUPC_ЗарплатаNetСрезПоследних.Организация
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФОТ КАК ВТ_ФОТ
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, ) КАК КурсыВалютСрезПоследнихLocal
			ПО ВТ_ФОТ.Валюта = КурсыВалютСрезПоследнихLocal.Валюта
		ПО (ВТ_ФОТ.ФизическоеЛицо = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо)
			И (ВТ_ФОТ.ГоловнаяОрганизация = ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация)
			И (ВТ_ФОТ.Сотрудник = ТекущиеКадровыеДанныеСотрудников.Сотрудник)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &amp;ВалютаUSD) КАК КурсыВалютСрезПоследнихUSD
		ПО (ИСТИНА)
ГДЕ
	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения &gt;= НАЧАЛОПЕРИОДА(&amp;ТекДата, МЕСЯЦ)
	И ТекущиеКадровыеДанныеСотрудников.ДатаПриема &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	И ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_NonEstablishedEmployees = ЛОЖЬ

ДЛЯ ИЗМЕНЕНИЯ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК Организация,
	ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
	1 КАК Количество,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_ActualPositionTitle КАК Position,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_ActualDepartmentName КАК Department,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_Desk_Team КАК Desk_Team,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_Locations КАК Location,
	ВЫБОР
		КОГДА ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net &gt; 0
			ТОГДА ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net
		ИНАЧЕ ВТ_ФОТ.ФОТ
	КОНЕЦ КАК Зарплата_net,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.ZUPC_DateJoingGroup КАК DateJoingGroup,
	ВЫБОР
		КОГДА ТекущиеКадровыеДанныеСотрудников.Сотрудник.Спеллинг &lt;&gt; ""
			ТОГДА ТекущиеКадровыеДанныеСотрудников.Сотрудник.Спеллинг
		ИНАЧЕ ТекущиеКадровыеДанныеСотрудников.Сотрудник
	КОНЕЦ КАК Спеллинг,
	ВТ_ФОТ.ФОТ КАК ФОТ,
	КурсыВалютСрезПоследнихLocal.Курс КАК Курс,
	КурсыВалютСрезПоследнихUSD.Курс КАК Курс1,
	ВЫБОР
		КОГДА ВТ_ФОТ.ОсновноеНачисление.Наименование &lt;&gt; "Оплата по окладу"
			ТОГДА ВЫРАЗИТЬ(КурсыВалютСрезПоследнихLocal.Курс * ВТ_ФОТ.ФОТ / КурсыВалютСрезПоследнихUSD.Курс КАК ЧИСЛО(15, 0))
		ИНАЧЕ ВЫРАЗИТЬ(ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net / КурсыВалютСрезПоследнихUSD.Курс КАК ЧИСЛО(15, 0))
	КОНЕЦ КАК SalaryUSD,
	ВТ_ФОТ.ОсновноеНачисление КАК ОсновноеНачисление,
	ВЫРАЗИТЬ(ZUPC_ЗарплатаNetСрезПоследних.Зарплата_net / КурсыВалютСрезПоследнихUSD.Курс КАК ЧИСЛО(15, 0)) КАК SalaryUSDNet,
	ЕСТЬNULL(ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_ActualDepartmentName.Приоритет, 0) КАК Приоритет,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо.ДатаРождения КАК ДатаРождения
ПОМЕСТИТЬ ВТРаботающие
ИЗ
	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ZUPC_ЗарплатаNet.СрезПоследних КАК ZUPC_ЗарплатаNetСрезПоследних
		ПО ТекущиеКадровыеДанныеСотрудников.Сотрудник = ZUPC_ЗарплатаNetСрезПоследних.Сотрудник
			И ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = ZUPC_ЗарплатаNetСрезПоследних.ФизическоеЛицо
			И ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = ZUPC_ЗарплатаNetСрезПоследних.Организация
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФОТ КАК ВТ_ФОТ
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, ) КАК КурсыВалютСрезПоследнихLocal
			ПО ВТ_ФОТ.Валюта = КурсыВалютСрезПоследнихLocal.Валюта
		ПО (ВТ_ФОТ.ФизическоеЛицо = ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо)
			И (ВТ_ФОТ.ГоловнаяОрганизация = ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация)
			И (ВТ_ФОТ.Сотрудник = ТекущиеКадровыеДанныеСотрудников.Сотрудник)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &amp;ВалютаUSD) КАК КурсыВалютСрезПоследнихUSD
		ПО (ИСТИНА)
ГДЕ
	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	И ТекущиеКадровыеДанныеСотрудников.ДатаПриема &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	И ТекущиеКадровыеДанныеСотрудников.Сотрудник.ZUPC_NonEstablishedEmployees = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТРаботающие.Сотрудник КАК Сотрудник,
	ВТРаботающие.Организация КАК Организация,
	ВТРаботающие.ДатаПриема КАК ДатаПриема,
	ВТРаботающие.Количество КАК Количество,
	ВТРаботающие.Position КАК Position,
	ВТРаботающие.Department КАК Department,
	ВТРаботающие.Desk_Team КАК Desk_Team,
