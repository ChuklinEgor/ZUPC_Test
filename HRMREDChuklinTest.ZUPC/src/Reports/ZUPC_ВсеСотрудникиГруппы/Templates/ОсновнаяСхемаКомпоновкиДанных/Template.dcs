		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗарплатаПослеИспСрока</dataPath>
			<field>ЗарплатаПослеИспСрока</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗарплатаЧерез6Мес</dataPath>
			<field>ЗарплатаЧерез6Мес</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗарплатаЧерезГод</dataPath>
			<field>ЗарплатаЧерезГод</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Сотрудники.Ссылка КАК Наименование,
	Сотрудники.ГоловнаяОрганизация КАК Организация,
	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
	Сотрудники.ВАрхиве КАК ВАрхиве,
	Сотрудники.ФизическоеЛицо.ДатаРождения КАК ДатаРождения,
	Сотрудники.ФизическоеЛицо.Пол КАК Пол,
	Сотрудники.Зарплата_net КАК Зарплата_net,
	Сотрудники.Руководитель КАК Руководитель,
	Сотрудники.Возраст КАК Возраст,
	Сотрудники.ZUPC_ActualPositionTitle КАК ФактическаяДолжность,
	Сотрудники.Офис КАК Офис,
	Сотрудники.Офис КАК НомерОфиса,
	Сотрудники.НомерМеста КАК НомерМеста,
	Сотрудники.ЗарплатаПослеИспСрока КАК ЗарплатаПослеИспСрока,
	Сотрудники.ЗарплатаЧерез6Мес КАК ЗарплатаЧерез6Мес,
	Сотрудники.ЗарплатаЧерезГод КАК ЗарплатаЧерезГод
ИЗ
	Справочник.Сотрудники КАК Сотрудники</query>
	</dataSet>
	<calculatedField>
		<dataPath>ВозрастВ</dataPath>
		<expression>РАЗНОСТЬДАТ(ДатаРождения, ТекущаяДата(), "ГОД")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Возраст</v8:content>
			</v8:item>
		</title>
	</calculatedField>
