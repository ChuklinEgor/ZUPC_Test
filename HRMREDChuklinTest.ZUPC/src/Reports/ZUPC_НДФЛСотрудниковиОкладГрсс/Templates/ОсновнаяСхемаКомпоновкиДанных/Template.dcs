		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ТЗНДФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
	ТЗНДФЛ.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	ТЗНДФЛ.Год КАК Год,
	ТЗНДФЛ.Месяц КАК Месяц,
	ТЗНДФЛ.Ставка КАК Ставка
ПОМЕСТИТЬ ВТ
ИЗ
	ТЗНДФЛ КАК ТЗНДФЛ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.ФизическоеЛицо КАК ФизическоеЛицо,
	ВТ.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	ВТ.Год КАК Год,
	ВТ.Месяц КАК Месяц,
	ВТ.Ставка КАК Ставка
ПОМЕСТИТЬ ВТНДФЛ
ИЗ
	ВТ КАК ВТ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК Организация,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Зарплата_net КАК Зарплата_net,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ЗарплатаПослеИспСрока КАК ЗарплатаПослеИспСрока,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ЗарплатаЧерез6Мес КАК ЗарплатаЧерез6Мес,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ЗарплатаЧерезГод КАК ЗарплатаЧерезГод,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.HiringSalary КАК ЗарплатаТекущая,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.УдаленнаяРабота КАК УдаленнаяРабота,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Валюта КАК Валюта,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
	МАКСИМУМ(ПлановыйФОТИтоги.Период) КАК Период,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Руководитель КАК Руководитель
ПОМЕСТИТЬ ВТГруппировка
ИЗ
	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыйФОТИтоги КАК ПлановыйФОТИтоги
		ПО ТекущиеКадровыеДанныеСотрудников.Сотрудник = ПлановыйФОТИтоги.Сотрудник
			И ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = ПлановыйФОТИтоги.ФизическоеЛицо
ГДЕ
	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	И ТекущиеКадровыеДанныеСотрудников.ДатаПриема &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)

СГРУППИРОВАТЬ ПО
	ТекущиеКадровыеДанныеСотрудников.Сотрудник,
	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Зарплата_net,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ЗарплатаПослеИспСрока,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ЗарплатаЧерез6Мес,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.ЗарплатаЧерезГод,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.HiringSalary,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.УдаленнаяРабота,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Валюта,
	ТекущиеКадровыеДанныеСотрудников.Сотрудник.Руководитель
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТГруппировка.Сотрудник КАК Сотрудник,
	ВТГруппировка.Организация КАК Организация,
	ВТГруппировка.Зарплата_net КАК Зарплата_net,
	ВТГруппировка.ЗарплатаПослеИспСрока КАК ЗарплатаПослеИспСрока,
	ВТГруппировка.ЗарплатаЧерез6Мес КАК ЗарплатаЧерез6Мес,
	ВТГруппировка.ЗарплатаЧерезГод КАК ЗарплатаЧерезГод,
	ВТГруппировка.ЗарплатаТекущая КАК ЗарплатаТекущая,
	ВТГруппировка.УдаленнаяРабота КАК УдаленнаяРабота,
	ВТГруппировка.Валюта КАК Валюта,
	ВТГруппировка.ФизическоеЛицо КАК ФизическоеЛицо,
	ВТГруппировка.Период КАК Период,
	ПлановыйФОТИтоги.ФОТ КАК ФОТ,
	ВТГруппировка.Руководитель КАК Руководитель
ПОМЕСТИТЬ ВТ_ОКЛАД
ИЗ
	ВТГруппировка КАК ВТГруппировка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыйФОТИтоги КАК ПлановыйФОТИтоги
		ПО ВТГруппировка.Сотрудник = ПлановыйФОТИтоги.Сотрудник
			И ВТГруппировка.Организация = ПлановыйФОТИтоги.ГоловнаяОрганизация
			И ВТГруппировка.Период = ПлановыйФОТИтоги.Период
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТНДФЛ.ГоловнаяОрганизация КАК Организация,
	ВТ_ОКЛАД.Сотрудник КАК Сотрудник,
	ВТНДФЛ.ФизическоеЛицо КАК ФизическоеЛицо,
	ВТНДФЛ.Год КАК Год,
	ВТНДФЛ.Месяц КАК Месяц,
	ВТНДФЛ.Ставка КАК Ставка,
	ВТ_ОКЛАД.Зарплата_net КАК Зарплата_net,
	ВТ_ОКЛАД.ЗарплатаПослеИспСрока КАК ЗарплатаПослеИспСрока,
	ВТ_ОКЛАД.ЗарплатаЧерез6Мес КАК ЗарплатаЧерез6Мес,
	ВТ_ОКЛАД.ЗарплатаЧерезГод КАК ЗарплатаЧерезГод,
	ВТ_ОКЛАД.ЗарплатаТекущая КАК ЗарплатаТекущая,
	ВТ_ОКЛАД.УдаленнаяРабота КАК УдаленнаяРабота,
	ВТ_ОКЛАД.Валюта КАК Валюта,
	ВТ_ОКЛАД.Период КАК Период,
	ВТ_ОКЛАД.ФОТ КАК ЗарплатаГросс,
	ВЫБОР
		КОГДА ЗНАЧЕНИЕ(Перечисление.НДФЛСтавки.Ставка13) = ВТНДФЛ.Ставка
			ТОГДА 0.13
		ИНАЧЕ 0.15
	КОНЕЦ КАК СтавкаЧисло,
	ВТ_ОКЛАД.ФОТ - ВТ_ОКЛАД.ФОТ * ВЫБОР
		КОГДА ЗНАЧЕНИЕ(Перечисление.НДФЛСтавки.Ставка13) = ВТНДФЛ.Ставка
			ТОГДА 0.13
		ИНАЧЕ 0.15
	КОНЕЦ КАК ОкладNetРасчетный,
	ВТ_ОКЛАД.Руководитель КАК Руководитель
ИЗ
	ВТНДФЛ КАК ВТНДФЛ
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОКЛАД КАК ВТ_ОКЛАД
		ПО ВТНДФЛ.ФизическоеЛицо = ВТ_ОКЛАД.ФизическоеЛицо
			И ВТНДФЛ.ГоловнаяОрганизация = ВТ_ОКЛАД.Организация</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
