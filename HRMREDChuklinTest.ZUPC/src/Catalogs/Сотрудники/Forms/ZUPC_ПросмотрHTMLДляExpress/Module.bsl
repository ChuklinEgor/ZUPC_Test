
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("HTMLДокумент") Тогда
		ЭтотОбъект.HTMLДокумент = Параметры.HTMLДокумент;
	КонецЕсли;
	Если Параметры.Свойство("ТекстСообщения") Тогда
		ЭтотОбъект.ТекстСообщения = Параметры.ТекстСообщения;
	КонецЕсли;
	Если Параметры.Свойство("КлючОповещения") Тогда
		ЭтотОбъект.КлючОповещения = Параметры.КлючОповещения;
	КонецЕсли;
	Если Параметры.Свойство("АвтоОтправка") Тогда
		ЭтотОбъект.АвтоОтправка = Параметры.АвтоОтправка;
	КонецЕсли;
	ЭтотОбъект.Заголовок = "Просмотр HTML для eXpress";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если АвтоОтправка Тогда
		ПодключитьОбработчикОжидания("НачатьАвтоОтправку", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьВExpress(Команда)
	
	Если Не ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ПриложениеДляСнимкаЭкранаДоступно() Тогда
		ПоказатьПредупреждение(, "Создание снимка экрана доступно только в Windows-клиенте с поддержкой буфера обмена.");
		Возврат;
	КонецЕсли;
	ОбработчикЗавершения = Новый ОписаниеОповещения("ПослеСозданияСнимкаЭкрана", ЭтотОбъект);
	//ОбращенияВТехническуюПоддержкуСлужебныйКлиент.ЗапроситьСозданиеСнимкаЭкрана(ОбработчикЗавершения);
	ЗапроситьСозданиеСнимкаЭкрана(ОбработчикЗавершения);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НачатьАвтоОтправку()
	
	ОтключитьОбработчикОжидания("НачатьАвтоОтправку");
	ЭтотОбъект.АвтоОтправка = Ложь;
	ОтправитьВExpress(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияСнимкаЭкрана(ДанныеСнимка, ДополнительныеПараметры) Экспорт
	
	Если ДанныеСнимка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		РезультатОтправки = ОтправитьСнимокВExpressНаСервере(ДанныеСнимка.АдресФайла, ДанныеСнимка.ПолноеИмяФайла, ТекстСообщения, КлючОповещения);
	Исключение
		ПоказатьПредупреждение(, "Не удалось отправить снимок в eXpress: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ОтправитьСнимокВExpressНаСервере(Знач АдресФайла, Знач ПолноеИмяФайла, Знач ТекстСообщения, Знач КлючОповещения)
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	УдалитьИзВременногоХранилища(АдресФайла);
	Если Не ЗначениеЗаполнено(ДвоичныеДанныеФайла) Тогда
		ВызватьИсключение "Не удалось получить данные снимка экрана.";
	КонецЕсли;
	НастройкиОповещения = RSN_eXpress.НастройкиОповещенияExpress(?(ЗначениеЗаполнено(КлючОповещения), КлючОповещения, "ПеремещениеСотрудника"));
	Соединение = Новый HTTPСоединение(НастройкиОповещения.BaseURL, , , , , НастройкиОповещения.Timeout, Новый ЗащищенноеСоединениеOpenSSL());
	ТокенДоступа = RSN_eXpress.ТокенБота(Соединение, НастройкиОповещения);
	РезультатОтправки = RSN_eXpress.ОтправитьИзображениеВExpress(
		Соединение,
		ТокенДоступа,
		НастройкиОповещения.IdЧата,
		ТекстСообщения,
		?(ЗначениеЗаполнено(ПолноеИмяФайла), ПолноеИмяФайла, "СнимокЭкрана.png"),
		ДвоичныеДанныеФайла,
		НастройкиОповещения.BotID);
	Возврат РезультатОтправки;
	
КонецФункции      

&НаКлиенте
Процедура ЗапроситьСозданиеСнимкаЭкрана(ОбработчикЗавершения) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОбработчикЗавершения", ОбработчикЗавершения);
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗапросаСоздатьСнимокЭкрана", ОбращенияВТехническуюПоддержкуСлужебныйКлиент, ДополнительныеПараметры);
	
	ТекстВопроса = НСтр("ru = 'Необходимо выделить весь экран или область для отвравки в Express.'");
	
	Кнопки = Новый СписокЗначений();
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Создать снимок экрана'"));
	Кнопки.Добавить(КодВозвратаДиалога.Пропустить, НСтр("ru = 'Пропустить'"));
	
	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Формирование скриншота для Express'");
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	ПараметрыВопроса.КнопкаПоУмолчанию = КодВозвратаДиалога.Да;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Оповещение, ТекстВопроса, Кнопки, ПараметрыВопроса);
	
КонецПроцедуры


#КонецОбласти
