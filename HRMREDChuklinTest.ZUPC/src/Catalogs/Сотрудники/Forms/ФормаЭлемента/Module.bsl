&НаСервере
Функция ВыполнитьЗапросИсторияМест()

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", Сотрудник.ФизическоеЛицо);//Горовых Юлия Анатольевна (Справочник.ФизическиеЛица)
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ZUPC_ИсторияStaffAccomodation.Период КАК Период,
	|	ZUPC_ИсторияStaffAccomodation.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ZUPC_ИсторияStaffAccomodation.Офис КАК Офис,
	|	ZUPC_ИсторияStaffAccomodation.НомерМеста КАК НомерМеста
	|ПОМЕСТИТЬ ВТВыборка
	|ИЗ
	|	РегистрСведений.ZUPC_ИсторияStaffAccomodation КАК ZUPC_ИсторияStaffAccomodation
	|ГДЕ
	|	ZUPC_ИсторияStaffAccomodation.ФизическоеЛицо = &ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТВыборка.Период) КАК Период,
	|	ВТВыборка.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВТВыборка.Офис КАК Офис,
	|	ВТВыборка.НомерМеста КАК НомерМеста,
	|	ВТВыборка1.Период КАК Период1,
	|	ВТВыборка.Офис КАК Офис1
	|ПОМЕСТИТЬ ВременнаяТаблица1
	|ИЗ
	|	ВТВыборка КАК ВТВыборка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыборка КАК ВТВыборка1
	|		ПО (ИСТИНА)
	|			И (ВТВыборка.ФизическоеЛицо = ВТВыборка1.ФизическоеЛицо)
	|			И (ВТВыборка.Период < ВТВыборка1.Период)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТВыборка.ФизическоеЛицо,
	|	ВТВыборка.Офис,
	|	ВТВыборка.НомерМеста,
	|	ВТВыборка1.Период,
	|	ВТВыборка.Офис
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВременнаяТаблица1.Период КАК Период,
	|	ВременнаяТаблица1.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВременнаяТаблица1.Офис КАК ОфисОткуда,
	|	ВременнаяТаблица1.НомерМеста КАК НомерМестаОткуда,
	|	МИНИМУМ(ВременнаяТаблица1.Период1) КАК Период1,
	|	ВТВыборка.НомерМеста КАК НомерМестаКуда,
	|	ВТВыборка.Офис КАК ОфисКуда
	|ИЗ
	|	ВременнаяТаблица1 КАК ВременнаяТаблица1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыборка КАК ВТВыборка
	|		ПО (ВременнаяТаблица1.ФизическоеЛицо = ВТВыборка.ФизическоеЛицо)
	|			И (ВременнаяТаблица1.Период1 = ВТВыборка.Период)
	|ГДЕ
	|	ВременнаяТаблица1.Период1 <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблица1.Период,
	|	ВременнаяТаблица1.ФизическоеЛицо,
	|	ВременнаяТаблица1.Офис,
	|	ВременнаяТаблица1.НомерМеста,
	|	ВТВыборка.НомерМеста,
	|	ВТВыборка.Офис
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Возврат  Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ЦЗ_ОтправитьвИТПослеНаСервере()
	
	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Системная учетная запись");
	
	Офис       =  Сотрудник.Офис;
	Офис 	   =  ?(ЗначениеЗаполнено(Офис),Офис, "Не указан");
	НомерМеста = Сотрудник.НомерМеста;
	НомерМеста = ?(ЗначениеЗаполнено(НомерМеста),НомерМеста,"Не указан");       
	СотрудникН = Сотрудник.ФизическоеЛицо;
	
	ТЗИстория = ВыполнитьЗапросИсторияМест();
	
	МИстория = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗИстория);
	
	Тема = "ЗУП: Перемещение сотрудника " + СотрудникН;      
	
	Макет = Справочники.Сотрудники.ПолучитьМакет("ХД_ПеремещениеСотрудника_HTML");	
	
	ТекстHTML = Макет.ПолучитьТекст();
	
	Для каждого эл Из МИстория[0] Цикл
		
		  ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл.Ключ+"}", МИстория[0][эл.Ключ]); 
		
	КонецЦикла;
	  
	ТекстHTML = СтрЗаменить(ТекстHTML, "{Комментарий}", Сотрудник.ZUPC_DescriptionAccomodation);   
	
	ДатаРожденияМ = Формат(Сотрудник.ФизическоеЛицо.ДатаРождения,"ДФ=dd.MM");
	ТекстHTML = СтрЗаменить(ТекстHTML, "{ДатаРождения}", ДатаРожденияМ); 
	
	ПолучателиПисьма =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Рассылка_Перемещение", Истина);
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", Тема);
	ПараметрыПисьма.Вставить("ТипТекста", Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
	ПараметрыПисьма.Вставить("Текст", ТекстHTML);
	ПараметрыПисьма.Вставить("ТекстHTML", ТекстHTML);
	ПараметрыПисьма.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыПисьма.Вставить("ПолучателиПисьма",ПолучателиПисьма);
	
	ЭлектронноеПисьмоИсходящее = УправлениеЭлектроннойПочтой.СоздатьИсходящееПисьмо(ПараметрыПисьма); 
	
КонецПроцедуры

&НаСервере
Функция ЦЗ_ПараметрыHTMLДляExpressНаСервере()
	
	Офис = Сотрудник.Офис;
	Офис = ?(ЗначениеЗаполнено(Офис), Офис, "Не указан");
	НомерМеста = Сотрудник.НомерМеста;
	НомерМеста = ?(ЗначениеЗаполнено(НомерМеста), НомерМеста, "Не указан");
	СотрудникН = Сотрудник.ФизическоеЛицо;
	ТЗИстория = ВыполнитьЗапросИсторияМест();
	МИстория = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗИстория);
	Тема = "ЗУП: Перемещение сотрудника " + СотрудникН;
	Макет = Справочники.Сотрудники.ПолучитьМакет("ХД_ПеремещениеСотрудника_HTML");
	ТекстHTML = Макет.ПолучитьТекст();   
	Если МИстория.Количество() > 0 Тогда
		Для каждого эл Из МИстория[0] Цикл
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл.Ключ+"}", МИстория[0][эл.Ключ]);
		КонецЦикла;
	КонецЕсли;
	ТекстHTML = СтрЗаменить(ТекстHTML, "{Комментарий}", Сотрудник.ZUPC_DescriptionAccomodation);
	Если МИстория.Количество() > 0 Тогда
		ДанныеПеремещения = МИстория[0];
	Иначе
		ДанныеПеремещения = Новый Структура;
	КонецЕсли;
	ТекстТаблицы = ЦЗ_СформироватьТекстТаблицыПеремещенияДляExpress(ДанныеПеремещения, СотрудникН);
	ПараметрыHTML = Новый Структура;
	ПараметрыHTML.Вставить("ТекстHTML", ТекстHTML);
	ПараметрыHTML.Вставить("ТекстТаблицы", ТекстТаблицы);
	ПараметрыHTML.Вставить("Тема", Тема);
	ПараметрыHTML.Вставить("КлючОповещения", "ПеремещениеСотрудника");
	Возврат ПараметрыHTML;
	
КонецФункции

&НаКлиенте
Процедура ЦЗ_ОтправитьвИТПосле(Команда) 
	Записать();
	ЦЗ_ОтправитьвИТПослеНаСервере(); 
	ОтправитьвИТПослеВExpress();
КонецПроцедуры  

Процедура ОтправитьвИТПослеВExpress()
	Попытка
		ПараметрыHTML = ЦЗ_ПараметрыHTMLДляExpressНаСервере();
	Исключение
		Сообщить("Не удалось подготовить HTML для eXpress: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Попытка
		ЦЗ_ОтправитьТаблицуПеремещенияВExpressНаСервере(
			ПараметрыHTML.ТекстТаблицы,
			ПараметрыHTML.Тема,
			ПараметрыHTML.КлючОповещения);
	Исключение
		Сообщить("Не удалось отправить таблицу в eXpress: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЦЗ_ОтправитьТаблицуПеремещенияВExpressНаСервере(Знач ТекстТаблицы, Знач Тема, Знач КлючОповещения)
	НастройкиОповещения = Неопределено;
	ИдЧатаДляЖурнала = "";
	ИдБотаДляЖурнала = "";
	Попытка
		НастройкиОповещения = RSN_eXpress.НастройкиОповещенияExpress(КлючОповещения);
		ИдЧатаДляЖурнала = НастройкиОповещения.IdЧата;
		КнопкиExpress = RSN_eXpress.ПолучитьКнопкиЧата(НастройкиОповещения.Чат);
		Соединение = Новый HTTPСоединение(
			НастройкиОповещения.BaseURL, , , , , НастройкиОповещения.Timeout, Новый ЗащищенноеСоединениеOpenSSL());
		ТокенДоступа = RSN_eXpress.ТокенБота(Соединение, НастройкиОповещения);
		ТекстСообщения = Тема + Символы.ПС + ТекстТаблицы;
		ЕстьКнопки = КнопкиExpress <> Неопределено
			И (КнопкиExpress.bubble.Количество() > 0 Или КнопкиExpress.keyboard.Количество() > 0);
		RSN_eXpress.ЗаписатьВЖурналИсходящееСообщениеExpress(УровеньЖурналаРегистрации.Информация,
			"Запрос", "Express.EmployeeTransfer", "", ИдЧатаДляЖурнала,
			ТекстСообщения, 0, "", ЕстьКнопки, НастройкиОповещения.BotID, СтрШаблон("КлючОповещения=%1", КлючОповещения));
		RSN_eXpress.ОтправитьСообщениеВExpress(
			Соединение,
			ТокенДоступа,
			НастройкиОповещения.IdЧата,
			ТекстСообщения,
			КнопкиExpress,
			НастройкиОповещения.BotID);
	Исключение
		ТекстСообщенияОшибка = Тема + Символы.ПС + ТекстТаблицы;
		ИдБотаДляЖурнала = ?(НастройкиОповещения = Неопределено, "", НастройкиОповещения.BotID);
		RSN_eXpress.ЗаписатьВЖурналИсходящееСообщениеExpress(УровеньЖурналаРегистрации.Ошибка,
			"Ошибка", "Express.EmployeeTransfer", "", ИдЧатаДляЖурнала,
			ТекстСообщенияОшибка, 0, ОписаниеОшибки(), Ложь, ИдБотаДляЖурнала, СтрШаблон("КлючОповещения=%1", КлючОповещения));
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ЦЗ_СформироватьТекстТаблицыПеремещенияДляExpress(ДанныеПеремещения, СотрудникН)
	
	Колонки = Новый Массив;
	Колонки.Добавить("Поле");
	Колонки.Добавить("Значение");
	Строки = Новый Массив;
	ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, "Сотрудник", СотрудникН);
	ОфисОткуда = ЦЗ_ЗначениеПеремещенияДляExpress(ДанныеПеремещения, "ОфисОткуда");
	НомерМестаОткуда = ЦЗ_ЗначениеПеремещенияДляExpress(ДанныеПеремещения, "НомерМестаОткуда");
	ОфисКуда = ЦЗ_ЗначениеПеремещенияДляExpress(ДанныеПеремещения, "ОфисКуда");
	НомерМестаКуда = ЦЗ_ЗначениеПеремещенияДляExpress(ДанныеПеремещения, "НомерМестаКуда");
	ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, "Офис откуда", ОфисОткуда);
	ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, "Номер места откуда", НомерМестаОткуда);
	ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, "Офис куда", ОфисКуда);
	ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, "Номер места куда", НомерМестаКуда);
	ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, "Комментарий", Сотрудник.ZUPC_DescriptionAccomodation);
	Возврат RSN_eXpress.СформироватьТекстТаблицыДляExpress(Колонки, Строки);
	
КонецФункции

&НаСервере
Процедура ЦЗ_ДобавитьСтрокуТаблицыПеремещенияДляExpress(Строки, Поле, Значение)
	
	СтрокаТаблицы = Новый Структура;
	СтрокаТаблицы.Вставить("Поле", Поле);
	СтрокаТаблицы.Вставить("Значение", ?(ЗначениеЗаполнено(Значение), Значение, "Не указан"));
	Строки.Добавить(СтрокаТаблицы);
	
КонецПроцедуры

&НаСервере
Функция ЦЗ_ЗначениеПеремещенияДляExpress(ДанныеПеремещения, ИмяПоля)
	
	Если ДанныеПеремещения.Свойство(ИмяПоля) Тогда
		Возврат ДанныеПеремещения[ИмяПоля];
	КонецЕсли;
	Возврат "";
	
