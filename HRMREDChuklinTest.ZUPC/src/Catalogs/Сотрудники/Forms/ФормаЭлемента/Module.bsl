  &НаСервере
Функция ИмяЭлементаЗаголовок(Знач стр)
	
	Для сч=1 по СтрДлина(стр) цикл
		ТекБуква=Сред(стр,сч,1);
		Если  ВРег(текбуква)=текбуква тогда
			Если  сч>1 тогда
				стр=Лев(стр,сч-1)+" "+нрег(текбуква)+сред(стр,сч+1,СтрДлина(стр))
			Иначе 
				//стр = нрег(Лев(стр,1))+Сред(стр,2);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;  
	
	Возврат стр;
		
КонецФункции 

&НаСервере
Функция СоздатьРеквизитФормы(Форма,ИмяЭлемента) Экспорт 
	
	Если Форма.Элементы.Найти(ИмяЭлемента) = Неопределено Тогда    
		ИмяЭлементаЗаголовок = ИмяЭлементаЗаголовок(ИмяЭлемента);  
		
		Если ИмяЭлемента =  "ДатаПолученияЖалобыОбращенияЗапроса"
			Или ИмяЭлемента =  "СрокНаправленияОтвета"
			Или ИмяЭлемента =  "ДатаОформленияПродукта"
			Тогда
			Тип = Новый ОписаниеТипов("Дата");
		ИначеЕсли ИмяЭлемента =  "Продукт"
			Или ИмяЭлемента =  "НаименованиеЗапрашиваемогоДокумента"
			Или ИмяЭлемента =  "ИсточникПолучения" Тогда 
			Тип = Новый ОписаниеТипов("Число");
		Иначе 
			Тип = Новый ОписаниеТипов("Строка");	
		КонецЕсли;
		Реквизит_Ф = Новый РеквизитФормы(ИмяЭлемента,	Тип,	, ИмяЭлементаЗаголовок);
	КонецЕсли;

	Возврат Реквизит_Ф;   
	
КонецФункции 

&НаСервере
Процедура ДобавитьРеквизитНаФорму(Форма,ИмяЭлемента,ГруппаФормы) Экспорт 
	
	фЭлемент =     Форма.Элементы.Найти(ИмяЭлемента);
	Если  фЭлемент = Неопределено Тогда
		ЭлементФормы = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаФормы); 
		Если ИмяЭлемента = "Продукт" Тогда
			ЭлементФормы.Вид = ВидПоляФормы.ПолеПереключателя;
			ЭлементФормы.КоличествоКолонок = 2;
			ЭлементФормы.СписокВыбора.Добавить(1,"ПИФ"); 
			ЭлементФормы.СписокВыбора.Добавить(2,"ДУ"); 
		ИначеЕсли ИмяЭлемента = "НаименованиеЗапрашиваемогоДокумента"  Тогда
			ЭлементФормы.Вид = ВидПоляФормы.ПолеПереключателя;
			ЭлементФормы.КоличествоКолонок = 4;
			ЭлементФормы.СписокВыбора.Добавить(1,"Отчет"); 
			ЭлементФормы.СписокВыбора.Добавить(2,"Справка5798У"); 
			ЭлементФормы.СписокВыбора.Добавить(3,"ИнойДокумент");
			ЭлементФормы.СписокВыбора.Добавить(4,"Иное");  
		ИначеЕсли ИмяЭлемента = "ИсточникПолучения"  Тогда
			ЭлементФормы.Вид = ВидПоляФормы.ПолеПереключателя;
			ЭлементФормы.КоличествоКолонок = 2;
			ЭлементФормы.СписокВыбора.Добавить(1,"Агент"); 
			ЭлементФормы.СписокВыбора.Добавить(2,"УК"); 
		Иначе 
			ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
		КонецЕсли;  
		ЭлементФормы.ПутьКДанным = "Сотрудник."+ИмяЭлемента; 
		ЭлементФормы.Видимость = Истина;
	Иначе 
		фЭлемент.Видимость = Истина; 	
	КонецЕсли;
	
КонецПроцедуры 

