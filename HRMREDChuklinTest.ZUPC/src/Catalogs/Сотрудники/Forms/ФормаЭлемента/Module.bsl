&НаКлиенте
Процедура ЦЗ_ОбработкаВыбораПосле(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "РегистрСведений.ZUPC_НовыеCотрудники.Форма.ФормаСпискаПодбора" Тогда
		
		КЗ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
		
		ЗаполнитьПоРегистру(КЗ);
		
	Иначе 
		
		КЗ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
		
		ЗаполнитьПоСотруднику(КЗ);	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоРегистру(КЗ)
	МЗ = РегистрыСведений.ZUPC_НовыеCотрудники.СоздатьМенеджерЗаписи();
	МЗ.СотрудникСтрока = КЗ.СотрудникСтрока;
	МЗ.Прочитать();    
	
	Если МЗ.Выбран() Тогда  
		
	Почта                    = МЗ.ЭлектроннаяПочта;
	Сотрудник.Офис 		 	 = МЗ.Офис;
	Сотрудник.НомерМеста     = МЗ.НомерМеста;
	Сотрудник.ОрганизоватьРабочееМесто   = МЗ.ОрганизоватьРабочееМесто;
	Сотрудник.СоздатьАккаунт = МЗ.СоздатьАккаунт;	
	Сотрудник.Пропуск		 = МЗ.Пропуск;
	Сотрудник.МобильныйТелефон  = МЗ.МобильныйТелефон;
	Сотрудник.Спеллинг 		 = МЗ.Спеллинг;
	Сотрудник.Руководитель   = МЗ.Руководитель;
	Сотрудник.ZUPC_ActualPositionTitle = МЗ.ActualPositionTitle; 
	Сотрудник.ZUPC_ActualDepartmentName = МЗ.ActualDepartmentName;
	Сотрудник.ZUPC_Locations = МЗ.Город;
	Сотрудник.УдаленнаяРабота  =мз.УдаленнаяРабота;  
	Сотрудник.Валюта 		 = МЗ.Валюта; 
	Сотрудник.ZUPC_RemoteWorkLocation = МЗ.ZUPC_RemoteWorkLocation;
	МЗ.Сотрудник = Сотрудник.Ссылка;
	МЗ.ФизическоеЛицо = Сотрудник.ФизическоеЛицо;
	МЗ.Записать();
	КонецЕсли;
	
	МЗ = РегистрыСведений.ZUPC_УчетнаяИнформацияПользователей.СоздатьМенеджерЗаписи();
	МЗ.СотрудникСтрока = КЗ.СотрудникСтрока;
    МЗ.Почта		= Почта;
	МЗ.Прочитать();    
	
	Если МЗ.Выбран() Тогда
		
		МЗ.ФизическоеЛицо = Сотрудник.ФизическоеЛицо;  
		МЗ.Записать();

	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПоРегистру()

&НаСервере
Процедура ЗаполнитьПоСотруднику(КЗ)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	Сотрудники.ZUPC_ActualDepartmentName КАК ZUPC_ActualDepartmentName,
		|	Сотрудники.ZUPC_Desk_Team КАК ZUPC_Desk_Team,
		|	Сотрудники.ZUPC_ActualPositionTitle КАК ZUPC_ActualPositionTitle,
		|	Сотрудники.Зарплата_net КАК Зарплата_net,
		|	Сотрудники.ЗарплатаПослеИспСрока КАК ЗарплатаПослеИспСрока,
		|	Сотрудники.ЗарплатаЧерез6Мес КАК ЗарплатаЧерез6Мес,
		|	Сотрудники.ЗарплатаЧерез9Мес КАК ЗарплатаЧерез9Мес,
		|	Сотрудники.ЗарплатаЧерезГод КАК ЗарплатаЧерезГод,
		|	Сотрудники.HiringSalary КАК HiringSalary,
		|	Сотрудники.ЗарплатаВОффере КАК ЗарплатаВОффере,
		|	Сотрудники.Руководитель КАК Руководитель,
		|	Сотрудники.Возраст КАК Возраст,
		|	Сотрудники.НомерМеста КАК НомерМеста,
		|	Сотрудники.Офис КАК Офис,
		|	Сотрудники.ОрганизоватьРабочееМесто КАК ОрганизоватьРабочееМесто,
		|	Сотрудники.СоздатьАккаунт КАК СоздатьАккаунт,
		|	Сотрудники.Пропуск КАК Пропуск,
		|	Сотрудники.МобильныйТелефон КАК МобильныйТелефон,
		|	Сотрудники.Спеллинг КАК Спеллинг,
		|	Сотрудники.КомментарииHR КАК КомментарииHR,
		|	Сотрудники.УдаленнаяРабота КАК УдаленнаяРабота,
		|	Сотрудники.ДМСЗаСвойСчет КАК ДМСЗаСвойСчет,
		|	Сотрудники.Валюта КАК Валюта,
		|	Сотрудники.ZUPC_DateJoingGroup КАК ZUPC_DateJoingGroup,
		|	Сотрудники.ZUPC_Rosneft КАК ZUPC_Rosneft,
		|	Сотрудники.ZUPC_RosneftDescription КАК ZUPC_RosneftDescription,
		|	Сотрудники.ZUPC_SignOnBonus КАК ZUPC_SignOnBonus,
		|	Сотрудники.ZUPC_PerformanceBonusPerOffer КАК ZUPC_PerformanceBonusPerOffer,
		|	Сотрудники.ZUPC_NonEstablishedEmployees КАК ZUPC_NonEstablishedEmployees,
		|	Сотрудники.ZUPC_RemoteWorkLocation КАК ZUPC_RemoteWorkLocation,
		|	Сотрудники.ZUPC_EmploymentInMultipleLocations КАК ZUPC_EmploymentInMultipleLocations,
		|	Сотрудники.ZUPC_SalaryInOffer КАК ZUPC_SalaryInOffer,
		|	Сотрудники.ZUPC_desk_missing КАК ZUPC_desk_missing,
		|	Сотрудники.ZUPC_Transfer КАК ZUPC_Transfer,
		|	Сотрудники.ZUPC_Locations КАК ZUPC_Locations
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", КЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Сотрудник, ВыборкаДетальныеЗаписи);
		
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьПоРегистру()

// программное отображение формы
&НаСервере
Процедура ПриСозданииНаСервереУКС(Форма, ДопПараметры = Неопределено) Экспорт
	
 Если Форма.ИмяФормы = "Справочник.Сотрудники.Форма.ФормаЭлемента" Тогда
		
		УдаляемыеРеквизиты = Новый Массив;
		
		Если  ДопПараметры.Свойство("ПриСозданииНаСервере") Тогда
			
			ДобавляемыеРеквизиты	= Новый Массив;
			
				#Область ДобавлениеРеквизитовФормы
				пРеквизиты = ДопПараметры.Реквизиты;
				
				Для каждого эл Из  пРеквизиты Цикл
					эл = СтрЗаменить(эл, Символы.ПС, "");		//Символ(182)		
					Реквизит_Ф = СоздатьРеквизитФормы(Форма,эл);
					Если Реквизит_Ф <> Неопределено Тогда
						ДобавляемыеРеквизиты.Добавить(Реквизит_Ф);
					КонецЕсли;
				КонецЦикла;
				
				Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);   
				#КонецОбласти
				
				#Область ДобавлениеСкрытиеЭлементовФормы
				ИмяГруппы = ДопПараметры.ИмяГруппы;
				ГруппаФормы = Форма.Элементы.Найти(ИмяГруппы); 
				Если ГруппаФормы <> Неопределено Тогда
					
					Для каждого эл Из  пРеквизиты Цикл 
						эл = СтрЗаменить(эл, Символы.ПС, "");		//Символ(182)		
						ДобавитьРеквизитНаФорму(Форма,эл,ГруппаФормы);  
					КонецЦикла;
					
				КонецЕсли; 
				
				пРеквизитыСкрываем = ДопПараметры.РеквизитыСкрываем;  
				
				Для каждого эл Из пРеквизитыСкрываем Цикл
					эл = СтрЗаменить(эл, Символы.ПС, "");
					СкрытьРеквизитыСФормы(Форма,эл);
				КонецЦикла;
				#КонецОбласти

				#Область ЗаполнениеДанных
				Для каждого эл Из  пРеквизиты Цикл
					эл = СтрЗаменить(эл, Символы.ПС, ""); 
					Форма[эл] = 	Форма[ДопПараметры.ОсновнойРеквизитФормы][эл];
				КонецЦикла;
				#КонецОбласти

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

