Функция ПолучитьРазницуПоКлючам(соЛокал, соВнешн)
	
	соРазница = новый Массив;
	
	Для Каждого Стр Из соЛокал Цикл
		Если соВнешн.Получить(Стр.Ключ) = Неопределено Тогда
			мСтр = Стр.Значение;
			соРазница.Добавить(мСтр); 
		КонецЕсли;
	КонецЦикла; 
	
	Если соЛокал.Количество()=0 и соВнешн.Количество() <>0  Тогда
	
		соРазница.Добавить("первая запись");	
	
	КонецЕсли;
	
	Возврат соРазница;

КонецФункции // ф()

&НаСервере
Процедура ZUPC_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Попытка
		
		мРез = ЗапроскИстоииРассадки();
		мРезФорма = ДанныеНаФормевВыб();
		
		КлючиИст =	ПолучитьКлючиСтр(мРез);
		КлючиФ =	ПолучитьКлючиСтр(мРезФорма);    
		
		Рез = ПолучитьРазницуПоКлючам(КлючиИст,КлючиФ);
		
		Если ЗначениеЗаполнено(Сотрудник.ФизическоеЛицо) и ЗначениеЗаполнено(Сотрудник.Офис)  и Рез.Количество()>0 Тогда 
			
			МЗ =   РегистрыСведений.ZUPC_ИсторияStaffAccomodation.СоздатьМенеджерЗаписи();
			МЗ.Период =  ТекущаяДата();
			МЗ.ФизическоеЛицо = Сотрудник.ФизическоеЛицо;
			МЗ.Прочитать(); 
			
			Если  Не МЗ.Выбран()  Тогда
				МЗ.Период = ТекущаяДата();
				МЗ.ФизическоеЛицо = Сотрудник.ФизическоеЛицо;
				МЗ.Офис 	 = Сотрудник.Офис;
				МЗ.НомерМеста =  Сотрудник.НомерМеста;	
				МЗ.Записать();    
			КонецЕсли;

			
			КонецЕсли;
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ДанныеНаФормевВыб()

	мРезультат = новый Массив;
	
	Стр = Новый Массив;

	Стр.Добавить(ЗначениеВСтрокуВнутр(Сотрудник.ФизическоеЛицо));
	Стр.Добавить(ЗначениеВСтрокуВнутр(Сотрудник.Офис));
	Стр.Добавить(ЗначениеВСтрокуВнутр(Сотрудник.НомерМеста));

	мРезультат.Добавить(Стр);

	Возврат мРезультат;

КонецФункции // ДанныеНаФормевВыб()()


&НаСервере
Функция ЗапроскИстоииРассадки()
	
	Запрос = Новый Запрос;
	
	//Установка значений параметров
	Запрос.УстановитьПараметр("ФизическоеЛицо", Сотрудник.ФизическоеЛицо);//Есенов Алан Владимирович (Справочник.ФизическиеЛица)
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ZUPC_ИсторияStaffAccomodationСрезПоследних.Период КАК Период,
	|	ZUPC_ИсторияStaffAccomodationСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ZUPC_ИсторияStaffAccomodationСрезПоследних.Офис КАК Офис,
	|	ZUPC_ИсторияStaffAccomodationСрезПоследних.НомерМеста КАК НомерМеста
	|ИЗ
	|	РегистрСведений.ZUPC_ИсторияStaffAccomodation.СрезПоследних(, ФизическоеЛицо = &ФизическоеЛицо) КАК ZUPC_ИсторияStaffAccomodationСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();     
	
	
	мРезультат = Новый Массив;
	ПоляС = "ФизическоеЛицо,Офис,НомерМеста";
	Поля = СтрРазделить(ПоляС,",");
	
	Пока Выборка.Следующий() Цикл
		Стр = Новый Массив;
		Для Каждого Изм Из Поля Цикл
			Зн = Выборка[Изм];
			//Если Внутр Тогда
				Если ТипЗнч(Выборка[Изм]) = Тип("УникальныйИдентификатор") Тогда
					Зн1 = Строка(Выборка[Изм]);   
					Зн = ЗначениеВСтрокуВнутр(Зн1);
				Иначе 	
					Зн = ЗначениеВСтрокуВнутр(Зн);
				КонецЕсли;
				
			//КонецЕсли;
			Стр.Добавить(Зн);
		КонецЦикла;
		мРезультат.Добавить(Стр);
	КонецЦикла;
	
	
	Возврат мРезультат;

КонецФункции // ПроверкаЗаписивРС()

&НаСервере
Функция ПолучитьКлючиСтр(Внешн, ИнС = Неопределено) Экспорт
	соВнешн = Новый Соответствие;
	//ИнС = Поля.Найти("ИдентификаторЗаписи");
	Для Каждого Стр Из Внешн Цикл
		Ключ = "";   
		сч = 0;
		Для Каждого Зн Из Стр Цикл  
			Если  ИнС = сч Тогда
				Продолжить;	
			КонецЕсли;
			
			Ключ = Ключ + Зн + ","; 
			сч = сч +1;
		КонецЦикла;
		
		соВнешн.Вставить(Ключ, Стр);
	КонецЦикла;
	
	Возврат соВнешн;
КонецФункции
