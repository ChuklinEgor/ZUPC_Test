&НаСервере
Процедура ПриВыбореНаСервереУКС(Форма, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Форма.ИмяФормы = "Справочник.ВходящиеДокументы.Форма.ФормаЭлемента" Тогда
		
		УдаляемыеРеквизиты = Новый Массив;
		
		Если ДополнительныеПараметры.Свойство("ПисьмоДля") или  ДополнительныеПараметры.Свойство("ПриСозданииНаСервере") Тогда
			
			Если ДополнительныеПараметры.Свойство("ПисьмоДля")  Тогда
			    ПисьмоДля = ДополнительныеПараметры.ПисьмоДля; 
			Иначе 
			    ПисьмоДля = Форма.Объект.ПисьмоДля;
			КонецЕсли;
			
			ДобавляемыеРеквизиты	= Новый Массив;
			
			Если  ПисьмоДля = 1  Тогда
				
				#Область ДобавлениеРеквизитовФормы
				пРеквизиты = СтрРазделить("Офис,НомерМеста",",");
				
				Для каждого эл Из  пРеквизиты Цикл
					эл = СтрЗаменить(эл, Символы.ПС, "");		//Символ(182)		
					Реквизит_Ф = СоздатьРеквизитФормы(Форма,эл);
					Если Реквизит_Ф <> Неопределено Тогда
						ДобавляемыеРеквизиты.Добавить(Реквизит_Ф);
					КонецЕсли;
				КонецЦикла;
				
				Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);   
				#КонецОбласти
				
				#Область ДобавлениеСкрытиеЭлементовФормы
				ИмяГруппы = "УведолмениеВIT";
				ГруппаФормы = Форма.Элементы.Найти(ИмяГруппы);
				Если ГруппаФормы <> Неопределено Тогда
					
					Для каждого эл Из  пРеквизиты Цикл 
						эл = СтрЗаменить(эл, Символы.ПС, "");		//Символ(182)		
						ДобавитьРеквизитНаФорму(Форма,эл,ГруппаФормы);  
					КонецЦикла;
					
				КонецЕсли; 
				
				//пРеквизитыСкрываем = СтрРазделить("НаименованиеЗапрашиваемогоДокумента",",");  
				//
				//Для каждого эл Из пРеквизитыСкрываем Цикл
				//	эл = СтрЗаменить(эл, Символы.ПС, "");
				//	СкрытьРеквизитыСФормы(Форма,эл);
				//КонецЦикла;
				#КонецОбласти

				#Область ЗаполнениеДанных
				Для каждого эл Из  пРеквизиты Цикл
					эл = СтрЗаменить(эл, Символы.ПС, ""); 
					Форма[эл] = 	Форма.Объект[эл];
				КонецЦикла;
				#КонецОбласти

			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
//ЭлементФормы.УстановитьДействие("ПриИзменении","ПриИзмененииПисьмоДля");
	
КонецПроцедуры 

