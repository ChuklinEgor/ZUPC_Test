#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(СостояниеЗаполнения) Тогда
		СостояниеЗаполнения = "Все";
	КонецЕсли;
	Элементы.СостояниеЗаполнения.СписокВыбора.Очистить();
	Элементы.СостояниеЗаполнения.СписокВыбора.Добавить("Все", "Все");
	Элементы.СостояниеЗаполнения.СписокВыбора.Добавить("Заполнены", "Заполнены");
	Элементы.СостояниеЗаполнения.СписокВыбора.Добавить("НеЗаполнены", "Не заполнены");
	ЗаполнитьНаСервере();	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	СохраненоДокументов = СохранитьНаСервере();
	Сообщить(СтрШаблон("Сохранено документов: %1", СохраненоДокументов));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура УвольненияДокументПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Увольнения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		Возврат;
	КонецЕсли;
	РеквизитыДокумента = РеквизитыУвольнения(ТекущиеДанные.Документ);
	ТекущиеДанные.ZUPC_PersonnelRelocation = РеквизитыДокумента.ZUPC_PersonnelRelocation;
	ТекущиеДанные.ZUPC_ReasonForTermination = РеквизитыДокумента.ZUPC_ReasonForTermination;
	ТекущиеДанные.ZUPC_RemarksReasonOfLeaving = РеквизитыДокумента.ZUPC_RemarksReasonOfLeaving;
КонецПроцедуры

&НаКлиенте
Процедура УвольненияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "УвольненияДокумент" И Не Элемент.ТекущиеДанные = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Элемент.ТекущиеДанные.Документ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	Увольнения.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Увольнение.Ссылка КАК Документ,
		|	Увольнение.ZUPC_PersonnelRelocation КАК ZUPC_PersonnelRelocation,
		|	Увольнение.ZUPC_ReasonForTermination КАК ZUPC_ReasonForTermination,
		|	Увольнение.ZUPC_RemarksReasonOfLeaving КАК ZUPC_RemarksReasonOfLeaving,
		|	Увольнение.Сотрудник КАК Сотрудник
		|ИЗ
		|	Документ.Увольнение КАК Увольнение
		|ГДЕ
		|	НЕ Увольнение.ПометкаУдаления
		|	И (&ИспользоватьОрганизацию = ЛОЖЬ
		|			ИЛИ Увольнение.Организация = &Организация)
		|	И (&ИспользоватьСотрудника = ЛОЖЬ
		|			ИЛИ Увольнение.Сотрудник = &Сотрудник)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Увольнение.ДатаУвольнения УБЫВ,
		|	Увольнение.Сотрудник";
	Запрос.УстановитьПараметр("ИспользоватьОрганизацию", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИспользоватьСотрудника", ЗначениеЗаполнено(Сотрудник));
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не СтрокаСоответствуетСостояниюЗаполнения(Выборка) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Увольнения.Добавить();
		НоваяСтрока.Заполнить = Ложь;
		НоваяСтрока.Документ = Выборка.Документ;
		НоваяСтрока.ZUPC_PersonnelRelocation = Выборка.ZUPC_PersonnelRelocation;
		НоваяСтрока.ZUPC_ReasonForTermination = Выборка.ZUPC_ReasonForTermination;
		НоваяСтрока.ZUPC_RemarksReasonOfLeaving = Выборка.ZUPC_RemarksReasonOfLeaving;
		НоваяСтрока.Сотрудник = Выборка.Сотрудник;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()
	СохраненоДокументов = 0;
	Для Каждого СтрокаУвольнения Из Увольнения Цикл
		Если Не СтрокаУвольнения.Заполнить Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаУвольнения.Документ) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектДокумента = СтрокаУвольнения.Документ.ПолучитьОбъект();
		ОбъектДокумента.ZUPC_PersonnelRelocation = СтрокаУвольнения.ZUPC_PersonnelRelocation;
		ОбъектДокумента.ZUPC_ReasonForTermination = СтрокаУвольнения.ZUPC_ReasonForTermination;
		ОбъектДокумента.ZUPC_RemarksReasonOfLeaving = СтрокаУвольнения.ZUPC_RemarksReasonOfLeaving;
		ОбъектДокумента.ОбменДанными.Загрузка = Истина;
		ОбъектДокумента.Записать(РежимЗаписиДокумента.Запись);
		СохраненоДокументов = СохраненоДокументов + 1;
	КонецЦикла;
	Возврат СохраненоДокументов;
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыУвольнения(Документ)
	Результат = Новый Структура("ZUPC_PersonnelRelocation, ZUPC_ReasonForTermination, ZUPC_RemarksReasonOfLeaving");
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Увольнение.ZUPC_PersonnelRelocation КАК ZUPC_PersonnelRelocation,
		|	Увольнение.ZUPC_ReasonForTermination КАК ZUPC_ReasonForTermination,
		|	Увольнение.ZUPC_RemarksReasonOfLeaving КАК ZUPC_RemarksReasonOfLeaving
		|ИЗ
		|	Документ.Увольнение КАК Увольнение
		|ГДЕ
		|	Увольнение.Ссылка = &Документ";
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ZUPC_PersonnelRelocation = Выборка.ZUPC_PersonnelRelocation;
		Результат.ZUPC_ReasonForTermination = Выборка.ZUPC_ReasonForTermination;
		Результат.ZUPC_RemarksReasonOfLeaving = Выборка.ZUPC_RemarksReasonOfLeaving;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Функция СтрокаСоответствуетСостояниюЗаполнения(СтрокаУвольнения)
	Если СостояниеЗаполнения = "Все" Тогда
		Возврат Истина;
	КонецЕсли;
	РеквизитыЗаполнены = РеквизитыZUPCЗаполнены(СтрокаУвольнения);
	Если СостояниеЗаполнения = "Заполнены" Тогда
		Возврат РеквизитыЗаполнены;
	КонецЕсли;
	Если СостояниеЗаполнения = "НеЗаполнены" Тогда
		Возврат Не РеквизитыЗаполнены;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыZUPCЗаполнены(СтрокаУвольнения)
	Возврат СтрокаУвольнения.ZUPC_PersonnelRelocation
		Или ЗначениеЗаполнено(СтрокаУвольнения.ZUPC_ReasonForTermination)
		Или ЗначениеЗаполнено(СтрокаУвольнения.ZUPC_RemarksReasonOfLeaving);
КонецФункции

#КонецОбласти
