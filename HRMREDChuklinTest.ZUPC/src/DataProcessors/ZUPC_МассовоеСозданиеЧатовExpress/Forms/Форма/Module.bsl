#Область ОбработчикиСобытийФормы 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ЧатШаблон.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Чаты"); 
	Элементы.СотрудникиЧаты.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Чаты");
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ЗаполнитьСотрудников(Команда)
	ЗаполнитьСотрудниковНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьEmail(Команда)
	ПолучитьEmailНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьHuid(Команда)
	ЗаполнитьHuidНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЧаты(Команда)
	Если Не ЗначениеЗаполнено(ЧатШаблон) Тогда
		Сообщить("Выберите чат-шаблон.");
		Возврат;
	КонецЕсли;
	СоздатьЧатыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыФормы, Элементы.Сотрудники);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючОповещения(Команда)
	Если Не ЗначениеЗаполнено(КлючОповещенияДляРегистра) Тогда
		Сообщить("Заполните ключ оповещения.");
		Возврат;
	КонецЕсли;
	ЗаполнитьКлючОповещенияНаСервере();
КонецПроцедуры     

&НаКлиенте
Процедура ПолучитьЧаты(Команда)
	ПолучитьЧатыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьПриветственноеСообщение(Команда)
	ОтправитьПриветственноеСообщениеНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаКлиенте
Процедура СотрудникиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого Сотрудник Из ВыбранноеЗначение Цикл
			ДобавитьСотрудникаИзПодбора(Сотрудник);
		КонецЦикла;
	Иначе
		ДобавитьСотрудникаИзПодбора(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСотрудникаИзПодбора(Сотрудник)
	Если Не ЗначениеЗаполнено(Сотрудник) Или СотрудникУжеЕстьВТаблицеНаКлиенте(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	НоваяСтрока = Сотрудники.Добавить();
	НоваяСтрока.Сотрудник = Сотрудник;
КонецПроцедуры

&НаКлиенте
Функция СотрудникУжеЕстьВТаблицеНаКлиенте(Сотрудник)
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Если СтрокаСотрудника.Сотрудник = Сотрудник Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаполнитьСотрудниковНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|ГДЕ
		|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И ТекущиеКадровыеДанныеСотрудников.ДатаПриема <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И (&ИспользоватьОрганизацию = ЛОЖЬ
		|		ИЛИ ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация = &Организация)
		|	И (&ИспользоватьПодразделение = ЛОЖЬ
		|		ИЛИ ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение = &Подразделение)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник";
	Запрос.УстановитьПараметр("ИспользоватьОрганизацию", ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИспользоватьПодразделение", ЗначениеЗаполнено(Подразделение));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если СотрудникУжеЕстьВТаблице(Выборка.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Сотрудники.Добавить();
		НоваяСтрока.Сотрудник = Выборка.Сотрудник;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПолучитьEmailНаСервере()
	СписокСотрудников = СписокСотрудниковДляЗапроса();
	Если СписокСотрудников.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТаблицаEmail = ТаблицаEmailСотрудников(СписокСотрудников);
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		НайденнаяСтрока = ТаблицаEmail.Найти(СтрокаСотрудника.Сотрудник, "Сотрудник");
		Если НайденнаяСтрока = Неопределено Или Не ЗначениеЗаполнено(НайденнаяСтрока.Email) Тогда
			СтрокаСотрудника.Email = EmailНеНайден();
		Иначе
			СтрокаСотрудника.Email = НайденнаяСтрока.Email;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьHuidНаСервере()    
	Если Не ЗначениеЗаполнено(ЧатШаблон) Тогда
		ВызватьИсключение "Не выбран чат-шаблон.";
	КонецЕсли;
	ЧатШаблонОбъект = ЧатШаблон.ПолучитьОбъект();
	ПодключениеExpress = ПодключениеExpressПоШаблону(ЧатШаблонОбъект);
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Если Не EmailЗаполненДляОбработки(СтрокаСотрудника.Email) Тогда
			СтрокаСотрудника.Huid = HuidНеПолучен();
			Продолжить;
		КонецЕсли;
		Попытка
			СтрокаСотрудника.Huid = RSN_eXpress.ИдентификаторПользователяПоЭлектроннойПочте(
				ПодключениеExpress.Соединение, ПодключениеExpress.Токен, СтрокаСотрудника.Email);
			Если ПустаяСтрока(СтрокаСотрудника.Huid) Тогда
				СтрокаСотрудника.Huid = HuidНеПолучен();
			КонецЕсли;
		Исключение
			СтрокаСотрудника.Huid = HuidНеПолучен(); 
			Сообщить(СтрШаблон(
				"Не удалось получить HUID для сотрудника %1: %2", СтрокаСотрудника.Сотрудник, ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СоздатьЧатыНаСервере() 
	Если Не ЗначениеЗаполнено(ЧатШаблон) Тогда
		ВызватьИсключение "Не выбран чат-шаблон.";
	КонецЕсли;
	ЧатШаблонОбъект = ЧатШаблон.ПолучитьОбъект();
	ПодключениеExpress = ПодключениеExpressПоШаблону(ЧатШаблонОбъект);
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл 
		СтрокаСотрудника.Чат = ЧатСотрудника(ЧатШаблонОбъект, СтрокаСотрудника.Email, СтрокаСотрудника.Huid); 
		Если Не EmailЗаполненДляОбработки(СтрокаСотрудника.Email)
			Или Не HuidЗаполненДляОбработки(СтрокаСотрудника.Huid) Тогда
			СтрокаСотрудника.Статус = "Не Успешно";
			Продолжить;
		КонецЕсли;
		Попытка
			ЧатСотрудника = ?(ЗначениеЗаполнено(СтрокаСотрудника.Чат), СтрокаСотрудника.Чат.ПолучитьОбъект(), Справочники.Чаты.СоздатьЭлемент());	
			СоздатьОбновитьЧатДляСотрудника(ЧатСотрудника, ЧатШаблонОбъект, ПодключениеExpress, СтрокаСотрудника); 
			СтрокаСотрудника.Статус = "Успешно"; 
			СтрокаСотрудника.Чат = ЧатСотрудника.Ссылка
		Исключение
			СтрокаСотрудника.Статус = "Не Успешно"; 
			Сообщить(СтрШаблон(
				"Не удалось создать чат для сотрудника %1: %2", СтрокаСотрудника.Сотрудник, ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СотрудникУжеЕстьВТаблице(Сотрудник)
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Если СтрокаСотрудника.Сотрудник = Сотрудник Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция СписокСотрудниковДляЗапроса()
	СписокСотрудников = Новый Массив;
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если СписокСотрудников.Найти(СтрокаСотрудника.Сотрудник) = Неопределено Тогда
			СписокСотрудников.Добавить(СтрокаСотрудника.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Возврат СписокСотрудников;
КонецФункции

&НаСервере
Функция ТаблицаEmailСотрудников(СписокСотрудников)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ZUPC_НовыеCотрудники.Сотрудник КАК Сотрудник,
		|	ZUPC_НовыеCотрудники.ЭлектроннаяПочта КАК Email
		|ИЗ
		|	РегистрСведений.ZUPC_НовыеCотрудники КАК ZUPC_НовыеCотрудники
		|ГДЕ
		|	ZUPC_НовыеCотрудники.Сотрудник В(&Сотрудники)";
	Запрос.УстановитьПараметр("Сотрудники", СписокСотрудников);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаСервере
Функция ПодключениеExpressПоШаблону(ЧатШаблонОбъект)
	Если Не ЗначениеЗаполнено(ЧатШаблонОбъект.Бот) Тогда
		ВызватьИсключение "В чате-шаблоне не заполнен бот.";
	КонецЕсли;
	ДанныеБота = RSN_eXpress.ДанныеБота(ЧатШаблонОбъект.Бот.BotID);
	Если Не ЗначениеЗаполнено(ДанныеБота.BaseURL)
		Или Не ЗначениеЗаполнено(ДанныеБота.BotID)
		Или Не ЗначениеЗаполнено(ДанныеБота.Signature) Тогда
		ВызватьИсключение "Не заполнены настройки бота eXpress.";
	КонецЕсли;
	Соединение = Новый HTTPСоединение(
		ДанныеБота.BaseURL, , , , , ДанныеБота.Timeout, Новый ЗащищенноеСоединениеOpenSSL());
	Токен = RSN_eXpress.ТокенБота(Соединение, ДанныеБота);
	Возврат Новый Структура("Соединение, Токен, ДанныеБота", Соединение, Токен, ДанныеБота);
КонецФункции

&НаСервере
Функция ЧатСотрудника(ЧатШаблонОбъект, Email, Huid)
	Если Не EmailЗаполненДляОбработки(Email) И Не HuidЗаполненДляОбработки(Huid) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Чаты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Чаты КАК Чаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Чаты.Участники КАК ЧатыУчастников
		|		ПО ЧатыУчастников.Ссылка = Чаты.Ссылка
		|ГДЕ
		|	НЕ Чаты.ПометкаУдаления
		|	И Чаты.Бот = &Бот
		|	И Чаты.ТипЧата = &ТипЧата
		|	И ЧатыУчастников.Huid = &Huid
		|	И ЧатыУчастников.Email = &Email";
	Запрос.УстановитьПараметр("Бот", ЧатШаблонОбъект.Бот);
	Запрос.УстановитьПараметр("ТипЧата", ЧатШаблонОбъект.ТипЧата);
	Запрос.УстановитьПараметр("Huid", ?(HuidЗаполненДляОбработки(Huid), Huid, ""));
	Запрос.УстановитьПараметр("Email", ?(EmailЗаполненДляОбработки(Email), Email, ""));   
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура СоздатьОбновитьЧатДляСотрудника(НовыйЧат, ЧатШаблонОбъект, ПодключениеExpress, СтрокаСотрудника)
	НовыйЧат.Бот = ЧатШаблонОбъект.Бот;
	НовыйЧат.Родитель = ЧатШаблонОбъект.Родитель;
	НовыйЧат.Наименование = ?(ДобавлятьВНаименованиеЧатаФамилиюСотрудника, СтрШаблон("%1: %2",ЧатШаблонОбъект.Наименование, СтрокаСотрудника.Сотрудник),
	ЧатШаблонОбъект.Наименование);
	НовыйЧат.ОписаниеЧата = ЧатШаблонОбъект.ОписаниеЧата;
	НовыйЧат.ПриветственноеСообщение = ЧатШаблонОбъект.ПриветственноеСообщение;
	НовыйЧат.СообщениеОбОбновленииФункционала = ЧатШаблонОбъект.СообщениеОбОбновленииФункционала;
	НовыйЧат.ТипЧата = ЧатШаблонОбъект.ТипЧата;
	НовыйЧат.Участники.Очистить();  
	НовыйУчастник = НовыйЧат.Участники.Добавить();
	НовыйУчастник.Email = СтрокаСотрудника.Email;
	НовыйУчастник.Huid = СтрокаСотрудника.Huid;  
	НовыйЧат.Команды.Очистить();
	Для Каждого Команда Из ЧатШаблонОбъект.Команды Цикл
		НоваяКоманда = НовыйЧат.Команды.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, Команда);
	КонецЦикла;
	УчастникиExpress = Новый Массив;
	УчастникиExpress.Добавить(СтрокаСотрудника.Huid);
	ДанныеЧата = Новый Структура(
		"ИмяЧата, ОписаниеЧата, ТипЧата", НовыйЧат.Наименование, НовыйЧат.ОписаниеЧата, НовыйЧат.ТипЧата);
	НовыйЧат.IdЧата = RSN_eXpress.СоздатьЧат(
		ПодключениеExpress.Соединение, ДанныеЧата, ПодключениеExpress.Токен, УчастникиExpress);
	НовыйЧат.Записать();
КонецПроцедуры    

&НаСервере
Процедура СоздатьКлючОповещенияДляЧата(НовыйЧат)
	МЗ = РегистрыСведений.RSN_НастройкиОповещенийExpress.СоздатьМенеджерЗаписи();
	МЗ.КлючОповещения = КлючОповещенияДляРегистра;
	МЗ.Бот = НовыйЧат.Бот;
	МЗ.Чат = НовыйЧат.Ссылка;
	МЗ.Записать();
КонецПроцедуры


&НаСервере
Функция EmailЗаполненДляОбработки(Email)
	СтрокаEmail = СокрЛП(Строка(Email));
	Возврат Не ПустаяСтрока(СтрокаEmail) И ВРег(СтрокаEmail) <> ВРег(EmailНеНайден());
КонецФункции

&НаСервере
Функция HuidЗаполненДляОбработки(Huid)
	СтрокаHuid = СокрЛП(Строка(Huid));
	Возврат Не ПустаяСтрока(СтрокаHuid) И ВРег(СтрокаHuid) <> ВРег(HuidНеПолучен());
КонецФункции

&НаСервере
Функция EmailНеНайден()
	Возврат "email не найден";
КонецФункции

&НаСервере
Функция HuidНеПолучен()
	Возврат "HUID не получен";
КонецФункции

&НаСервере
Процедура ЗаполнитьКлючОповещенияНаСервере()
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		Попытка
			СоздатьКлючОповещенияДляЧата(СтрокаСотрудника.Чат.ПолучитьОбъект());   
			СтрокаСотрудника.Статус = "Успешно"; 
		Исключение   
			СтрокаСотрудника.Статус = "Не Успешно"; 
			Сообщить(СтрШаблон(
			"Не удалось заполнить ключ оповещения для сотрудника %1: %2", СтрокаСотрудника.Сотрудник, ОписаниеОшибки()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПолучитьЧатыНаСервере()
	Если Не ЗначениеЗаполнено(ЧатШаблон) Тогда
		ВызватьИсключение "Не выбран чат-шаблон.";
	КонецЕсли;
	ЧатШаблонОбъект = ЧатШаблон.ПолучитьОбъект();
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл 
		СтрокаСотрудника.Чат = ЧатСотрудника(ЧатШаблонОбъект, СтрокаСотрудника.Email, СтрокаСотрудника.Huid); 
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОтправитьПриветственноеСообщениеНаСервере()
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл 
		Если ЗначениеЗаполнено(СтрокаСотрудника.Чат) Тогда  
			Справочники.Чаты.ОтправитьПриветственноеСообщение(СтрокаСотрудника.Чат.ПолучитьОбъект());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти
