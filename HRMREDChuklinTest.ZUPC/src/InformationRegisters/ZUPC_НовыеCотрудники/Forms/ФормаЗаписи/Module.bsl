#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьОтправкуСообщения(СотрудникСтрока)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВыполненныеРассылки.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.RSN_ВыполненныеРассылки КАК ВыполненныеРассылки
	|ГДЕ
	|	ВыполненныеРассылки.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Объект", СотрудникСтрока);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Процедура ЗаписатьЗавершениеУведомления(Сотрудник, Письмо)
	
	КонстантаРассылки = Справочники.ДополнительныеКонстанты.НайтиПоКоду("000000001");
	
	ВыпРас = РегистрыСведений.RSN_ВыполненныеРассылки.СоздатьМенеджерЗаписи();
	ВыпРас.Объект   = Сотрудник;
	ВыпРас.Рассылка = КонстантаРассылки;
	ВыпРас.Прочитать();
	
	Если Не ВыпРас.Выбран() Тогда
		ВыпРас.Объект                      = Сотрудник;
		ВыпРас.Рассылка                    = КонстантаРассылки;
		Если ЗначениеЗаполнено(Письмо) Тогда
			ВыпРас.ЭлектронноеПисьмоИсходящее = СтрШаблон("%1 № %2", Строка(Письмо), Письмо.Номер);
		КонецЕсли;
		ВыпРас.ДатаСоздания                = ТекущаяДатаСеанса();
		ВыпРас.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьвИТHTMLНаСервере()
	
	Контур = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Контур", Истина)[0];

	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Системная учетная запись");  
	
	Офис       =  Запись.Офис;
	Офис 	   =  ?(ЗначениеЗаполнено(Офис),Офис, "Нет");
	НомерМеста = Запись.НомерМеста;
	НомерМеста = ?(ЗначениеЗаполнено(НомерМеста),НомерМеста,"Нет");       
	ДатаВыхода = Формат(Запись.ДатаВыхода , "ДФ=dd.MM.yyyy");
	ДатаРождения = Формат(Запись.ДатаРождения,"ДФ=dd.MM");
	
	
	Текст = "";
	Тема  = "";
	
	ЕстьDNA = СтрНайти(Запись.КомментарийДляИТ, "DNA") > 0
		ИЛИ СтрНайти(Запись.ActualDepartmentName, "DNA") > 0; 
	Контур = ?(ЕстьDNA, "Green", Контур);
	
	Если Запись.Перевод  Тогда 
		
		Макет = РегистрыСведений.ZUPC_НовыеCотрудники.ПолучитьМакет("ХД_ПереводСотрудника_HTML");	
		
		ТекстHTML = Макет.ПолучитьТекст();
		
		СтрокаКолонок = "СотрудникСтрока,КомментарийДляИТ";
		
		мМассив  = СтрРазделить(СтрокаКолонок,",");
		
		Для каждого эл Из мМассив Цикл
			
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл+"}", Запись[эл]); 	
			
		КонецЦикла;  		
		Тема = "1C ZUP: ("+Контур +") "+ Запись.Город + " internal transfer  " + Запись.СотрудникСтрока;     
		
	ИначеЕсли Запись.Увольнение  Тогда 
		
		Макет = РегистрыСведений.ZUPC_НовыеCотрудники.ПолучитьМакет("ХД_УвольнениеСотрудника_HTML");	
		
		ТекстHTML = Макет.ПолучитьТекст();
		
		СтрокаКолонок = "СотрудникСтрока,ЭлектроннаяПочта,ДатаУвольнения,КомментарийДляИТ,Офис,НомерМеста";
		
		мМассив  = СтрРазделить(СтрокаКолонок,",");
		
		Для каждого эл Из мМассив Цикл
			
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл+"}", Запись[эл]); 	
			
		КонецЦикла;  		
		Тема = "1C ZUP: ("+Контур +") "+  Запись.Город +" resignation  " + Запись.СотрудникСтрока;
		
	ИначеЕсли Запись.ОтменаВыхода  Тогда 
		
		Макет = РегистрыСведений.ZUPC_НовыеCотрудники.ПолучитьМакет("ХД_ОтменаВыходаСотрудника_HTML");	
		
		ТекстHTML = Макет.ПолучитьТекст();
		
		СтрокаКолонок = "СотрудникСтрока,КомментарийДляИТ";
		
		мМассив  = СтрРазделить(СтрокаКолонок,",");
		
		Для каждого эл Из мМассив Цикл
			
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл+"}", Запись[эл]); 	
			
		КонецЦикла;  		
		
		Тема = "1C ZUP: ("+Контур +") "+  Запись.Город +" cancel joining  " + Запись.СотрудникСтрока; 
		
	ИначеЕсли Запись.ОтменаУвольнения  Тогда 
		
		Макет = РегистрыСведений.ZUPC_НовыеCотрудники.ПолучитьМакет("ХД_ОтменаУвольнения_HTML");	
		
		ТекстHTML = Макет.ПолучитьТекст();
		
		СтрокаКолонок = "СотрудникСтрока,КомментарийДляИТ";
		
		мМассив  = СтрРазделить(СтрокаКолонок,",");
		
		Для каждого эл Из мМассив Цикл
			
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл+"}", Запись[эл]); 	
			
		КонецЦикла;  
		Тема = "1C ZUP: ("+Контур +") "+ Запись.Город +" cancel termination  " + Запись.СотрудникСтрока;  
		
	ИначеЕсли Запись.Декрет  Тогда 
		
		Макет = РегистрыСведений.ZUPC_НовыеCотрудники.ПолучитьМакет("ХД_Декрет_HTML");	
		
		ТекстHTML = Макет.ПолучитьТекст();
		
		СтрокаКолонок = "СотрудникСтрока,КомментарийДляИТ";
		
		мМассив  = СтрРазделить(СтрокаКолонок,",");
		
		Для каждого эл Из мМассив Цикл
			
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл+"}", Запись[эл]); 	
			
		КонецЦикла;  
		Тема = "1C ZUP: ("+Контур +") "+  Запись.Город +" Decree  " + Запись.СотрудникСтрока;
		
	Иначе     
		
		Макет = РегистрыСведений.ZUPC_НовыеCотрудники.ПолучитьМакет("ХД_ВыходСотрудника_HTML");	
		
		ТекстHTML = Макет.ПолучитьТекст();
		
		СтрокаКолонок = "СотрудникСтрока,Спеллинг,ЭлектроннаяПочта,ДатаВыхода,Офис,НомерМеста,СоздатьАккаунт,Пропуск,МобильныйТелефон,Руководитель,ActualPositionTitle,ActualDepartmentName,ОрганизоватьРабочееМесто,Юр_Лицо,Город,УдаленнаяРабота,КомментарийДляИТ,ДолжностьСтрокой";
		
		мМассив  = СтрРазделить(СтрокаКолонок,",");
		
		Для каждого эл Из мМассив Цикл
			
			ТекстHTML = СтрЗаменить(ТекстHTML, "{"+эл+"}", Запись[эл]); 	
			
		КонецЦикла;  	
		
		ТекстHTML = СтрЗаменить(ТекстHTML, "{ДатаРождения}", ДатаРождения);
		
		Operations = ?(Запись.ActualDepartmentName.Наименование = "Operations", "OPS ", "");
		
		Тема = "1C ZUP: " + Operations + "("+Контур +") "+  Запись.Город +" new employee joining  " + Запись.СотрудникСтрока;
		
	КонецЕсли;
	
	Если Запись.Увольнение или Запись.ОтменаУвольнения Тогда 
		
		ПолучателиПисьма =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Рассылка_УволенныйСотрудник", Истина);
		
	Иначе 
		
		ПолучателиПисьма =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Рассылка_НовыхСотрудников", Истина);
		
	КонецЕсли;   
	
	Если ЕстьDNA Тогда
		Тема = СтрЗаменить(Тема, "ZUP:", "ZUP:DNA");
	КонецЕсли;
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", Тема);
	ПараметрыПисьма.Вставить("ТипТекста", Перечисления.ТипыТекстовЭлектронныхПисем.HTML);
	ПараметрыПисьма.Вставить("Текст", ТекстHTML);
	ПараметрыПисьма.Вставить("ТекстHTML", ТекстHTML);
	ПараметрыПисьма.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыПисьма.Вставить("ПолучателиПисьма", ПолучателиПисьма);
	//ПараметрыПисьма.Вставить("ПолучателиКопий", ПолучателиКопий);
	//ПараметрыПисьма.Вставить("Вложения", Вложения);
	
	ЭлектронноеПисьмоИсходящее = УправлениеЭлектроннойПочтой.СоздатьИсходящееПисьмо(ПараметрыПисьма);	
	
	Элементы.ДекорацияОтправлено.Подсказка = "Отправлено";
	Элементы.ДекорацияОтправлено.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
	
	ЗаписатьЗавершениеУведомления(Запись.СотрудникСтрока, ЭлектронноеПисьмоИсходящее);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ДоменПочты =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("ДоменПочты", Истина)[0];

	UserLogonName = СокрЛП(Запись.FirstName) + "."+ СокрЛП(Запись.LastName);    
	Спеллинг = СокрЛП(Запись.FirstName) + " "+ СокрЛП(Запись.LastName);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦЗ_УчетнаяИнформацияПользователей.UserLogonName КАК UserLogonName
		|ИЗ
		|	РегистрСведений.ZUPC_УчетнаяИнформацияПользователей КАК ЦЗ_УчетнаяИнформацияПользователей
		|ГДЕ
		|	ЦЗ_УчетнаяИнформацияПользователей.UserLogonName = &UserLogonName";
	
	Запрос.УстановитьПараметр("UserLogonName", UserLogonName);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий()Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Имя "+ UserLogonName+ " занято!
		| Подберите другое имя!";
		Сообщение.Поле = "Запись.UserLogonName";
		Сообщение.УстановитьДанные(Запись);
		Сообщение.Сообщить();
	Иначе
		Если Не Запись.РучнойВводИмени  Тогда
		   	Если  СтрДлина(UserLogonName)>20 Тогда
			
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Длинна UserLogonName " + UserLogonName+ " была больше 20 символов, 
				|и поменялась по правилу FirstName +  первая буква LastName!";
				Сообщение.Поле = "Запись.UserLogonName";
				Сообщение.УстановитьДанные(Запись);
				Сообщение.Сообщить(); 
				UserLogonName = СокрЛП(Запись.FirstName) + "." + Лев(Запись.LastName, 1);
				
			КонецЕсли;
			Запись.UserLogonName  = UserLogonName;   
			Запись.Спеллинг       = Спеллинг;
			Запись.ЭлектроннаяПочта =  UserLogonName + ДоменПочты;
		Иначе
			Запись.ЭлектроннаяПочта =  UserLogonName + ДоменПочты;
		КонецЕсли;
		
	КонецЕсли;	
	
	Элементы.ДлиннаUserLogonName.Заголовок = "Длинна user logon name " + СтрДлина(Запись.UserLogonName) + "символов";
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусПользователяВРегистре(Почта, СотрудникСтрока, УИДН, ФизЛицо, Отключить)
	
	МЗ =   РегистрыСведений.ZUPC_УчетнаяИнформацияПользователей.СоздатьМенеджерЗаписи();
	МЗ.Почта =  Почта;
	МЗ.СотрудникСтрока = СотрудникСтрока;
	МЗ.Прочитать();   
	Если МЗ.Выбран() Тогда  
		МЗ.УникальныйИдентификатор =  УИДН;	
		МЗ.Отключить = Ложь;
		Если ЗначениеЗаполнено(ФизЛицо) Тогда
			МЗ.ФизическоеЛицо = ФизЛицо;	
		КонецЕсли;
		
	Конецесли;
	МЗ.Записать(); 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПолейАгентскойПрограммы()
	Элементы.ГруппаReferree.Видимость = Запись.SearchSource = ПредопределенноеЗначение("Перечисление.ZUPC_SearchSource.Referral");
	Элементы.ГруппаAgency.Видимость = Запись.SearchSource = ПредопределенноеЗначение("Перечисление.ZUPC_SearchSource.Agency");
КонецПроцедуры  

&НаКлиенте
Процедура ОчиститьПоляАгентскойПрограммы()
	Если Запись.SearchSource = ПредопределенноеЗначение("Перечисление.ZUPC_SearchSource.Referral") Тогда
		Запись.AgencyName = ПредопределенноеЗначение("Справочник.ZUPC_Agency.ПустаяСсылка");
		Запись.AgentFee = 0;
	ИначеЕсли Запись.SearchSource = ПредопределенноеЗначение("Перечисление.ZUPC_SearchSource.Agency") Тогда
		Запись.Referree = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");	
	КонецЕсли;	
КонецПроцедуры
#КонецОбласти

&НаСервере
Процедура ОтправитьвИТНаСервере()
	
	УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("Системная учетная запись");
	
	Офис       =  Запись.Офис;
	Офис 	   =  ?(ЗначениеЗаполнено(Офис),Офис, "Нет");
	НомерМеста = Запись.НомерМеста;
	НомерМеста = ?(ЗначениеЗаполнено(НомерМеста),НомерМеста,"Нет");       
	ДатаВыхода = Формат(Запись.ДатаВыхода , "ДФ=dd.MM.yyyy");
	
	Текст = "";
	Тема  = "";
	
	Если Запись.Перевод  Тогда 
		
		Текст = Текст + СтрШаблон("Перевод  %1, комментарий для ИТ: %2"
		,Запись.СотрудникСтрока, Запись.КомментарийДляИТ);
		
		Тема = "ЗУП: Перевод сотрудника " + Запись.СотрудникСтрока;      
		
	ИначеЕсли Запись.Увольнение  Тогда 
		
		Текст = Текст + СтрШаблон("Увольнение  %1, дата увольнения: %2 комментарий для ИТ: %3"
		,Запись.СотрудникСтрока, Запись.ДатаУвольнения,Запись.КомментарийДляИТ);
		
		Тема = "ЗУП: Увольнение сотрудника " + Запись.СотрудникСтрока;
		
	ИначеЕсли Запись.ОтменаВыхода  Тогда 
		
		Текст = Текст + СтрШаблон("Отмена выхода  %1, комментарий для ИТ: %2"
		,Запись.СотрудникСтрока, Запись.КомментарийДляИТ);
		
		Тема = "ЗУП: Отмена выхода " + Запись.СотрудникСтрока; 
		
	ИначеЕсли Запись.ОтменаУвольнения  Тогда 
		
		Текст = Текст + СтрШаблон("Отмена увольнения  %1 комментарий для ИТ: %2"
		,Запись.СотрудникСтрока, Запись.КомментарийДляИТ);
		
		Тема = "ЗУП: Отмена увольнения сотрудника " + Запись.СотрудникСтрока;
		
	Иначе 
		
		Текст = Текст + СтрШаблон("Новый сотрудник %1, дата выхода %2,  офис %3, номер места %4,  
		|организовать рабочее место %5, создать аккаунт %6, пропуск %7, мобильный телефон %8,
		|руководитель %9, должность %10"
		,
		Запись.СотрудникСтрока, ДатаВыхода, Офис, НомерМеста,
		Запись.ОрганизоватьРабочееМесто,Запись.СоздатьАккаунт, Запись.Пропуск, Запись.МобильныйТелефон, 
		Запись.Руководитель, Запись.Должность);
		
		
		Текст = Текст + СтрШаблон(", отдел, %1, комментарий для ИТ: %2,
		|спеллинг: %3, организация: %4, город: %5, удаленная работа: %6",
		Запись.Отдел, Запись.КомментарийДляИТ, Запись.Спеллинг, Запись.Юр_Лицо, Запись.Город, Запись.УдаленнаяРабота); 
		
		Тема = "ЗУП: Выход нового сотрудника " + Запись.СотрудникСтрока;
		
	КонецЕсли;
	
	
	Если Запись.Увольнение  Тогда 
		
		ПолучателиПисьма =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Рассылка_УволенныйСотрудник", Истина);
		
	Иначе 
		
		ПолучателиПисьма =  RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Рассылка_НовыхСотрудников", Истина);
		
	КонецЕсли;
	
	//УчетнаяЗапись 		= Неопределено;
	//ПолучателиПисьма    = Новый Массив;
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", Тема);
	ПараметрыПисьма.Вставить("Текст", Текст);
	//ПараметрыПисьма.Вставить("Важность", Важность);
	ПараметрыПисьма.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыПисьма.Вставить("ПолучателиПисьма",ПолучателиПисьма);
	
	ЭлектронноеПисьмоИсходящее = УправлениеЭлектроннойПочтой.СоздатьИсходящееПисьмо(ПараметрыПисьма); 
	
	Элементы.ДекорацияОтправлено.Подсказка = "Отправлено";
	Элементы.ДекорацияОтправлено.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
	
	ЗаписатьЗавершениеУведомления(Запись.СотрудникСтрока, ЭлектронноеПисьмоИсходящее);	
	
КонецПроцедуры  


