
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ДлиннаUserLogonName.Заголовок = "Длинна user logon name " + СтрДлина(Запись.UserLogonName) + " символов";	
	
	Рез = ПроверитьОтправкуСообщения(Запись.СотрудникСтрока);
	Если Рез Тогда
		Элементы.ДекорацияОтправлено.Подсказка = "Отправлено";
		Элементы.ДекорацияОтправлено.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)   
	
	Запись.УникальныйИдентификатор = Новый УникальныйИдентификатор;
	ОчиститьПоляАгентскойПрограммы();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ЗначениеЗаполнено(Запись.UserLogonName) Тогда
		Возврат;
	КонецЕсли;
	
	ДоменПочты      = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("ДоменПочты", Истина)[0];
	Домен      = RSN_ОбщегоНазначенияПовтИсп.ЗначениеДополнительнойКонстанты("Домен", Истина)[0];
	UserLogonName   = Запись.UserLogonName;
	Почта           = Запись.ЭлектроннаяПочта;
	СотрудникСтрока = Запись.СотрудникСтрока;
	Спеллинг        = Запись.Спеллинг;
	ФизЛицо         = Запись.ФизическоеЛицо;
	УИДН            = Запись.УникальныйИдентификатор;
	
	Если Запись.Увольнение Или Запись.ОтменаВыхода Тогда
		
		ОбновитьСтатусПользователяВРегистре(Почта, СотрудникСтрока, УИДН, ФизЛицо, Истина);
		
	ИначеЕсли Запись.ОтменаУвольнения Тогда
		
		ОбновитьСтатусПользователяВРегистре(Почта, СотрудникСтрока, УИДН, ФизЛицо, Ложь);
		
	ИначеЕсли Запись.ПовторныйНайм Тогда
		// резервная логика для повторного найма — реализовать при необходимости
		
	Иначе
		
		МЗ =   РегистрыСведений.ZUPC_УчетнаяИнформацияПользователей.СоздатьМенеджерЗаписи();
			
			МЗ.Почта =  Почта;
			МЗ.СотрудникСтрока = СотрудникСтрока;
			МЗ.Прочитать(); 
			
			МЗ.Почта =  Почта;
			МЗ.СотрудникСтрока = СотрудникСтрока;
			МЗ.UserLogonName = UserLogonName;
			МЗ.Домен 		 = Домен;
			МЗ.ДоменПочты 	 = ДоменПочты;
			МЗ.Спеллинг 	 = Спеллинг;
			МЗ.FirstName 	 = Запись.FirstName;
			МЗ.LastName 	 = Запись.LastName;
			МЗ.УникальныйИдентификатор =  УИДН;	
			МЗ.Отключить = Ложь;   
			Если ЗначениеЗаполнено(ФизЛицо) Тогда
				МЗ.ФизическоеЛицо = ФизЛицо;	
			КонецЕсли;

			МЗ.Записать();;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьПолейАгентскойПрограммы();
КонецПроцедуры

#КонецОбласти

