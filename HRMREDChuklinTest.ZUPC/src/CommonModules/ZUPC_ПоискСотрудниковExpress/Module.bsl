#Область ПрограммныйИнтерфейс

// Ищет элементы справочника "Сотрудники" по фамилии физического лица.
// Сначала выполняется точное сравнение фамилии, а при отсутствии результата - нечеткое.
//
// Параметры:
//  Фамилия - Строка
//      Фамилия сотрудника без имени и отчества.
//
// Возвращаемое значение:
//  Структура
//      Поля:
//       * Сотрудники - Массив из Структура - найденные трудоустройства.
//       * НечеткийПоиск - Булево - признак использования нечеткого поиска.
//       * НайденнаяФамилия - Строка - фамилия, выбранная нечетким поиском.
//
Функция НайтиСотрудниковПоФамилии(Знач Фамилия) Экспорт
	ИскомаяФамилия = НормализованнаяФамилия(Фамилия);
	Результат = Новый Структура("Сотрудники, НечеткийПоиск, НайденнаяФамилия", Новый Массив, Ложь, "");
	Если ПустаяСтрока(ИскомаяФамилия) Тогда
		Возврат Результат;
	КонецЕсли;
	Кандидаты = ПолучитьКандидатовПоиска();
	ФизическиеЛица = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НормализованнаяФамилия(ФамилияИзФИО(Кандидат.ФИО)) = ИскомаяФамилия Тогда
			ФизическиеЛица.Добавить(Кандидат.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	Если ФизическиеЛица.Количество() = 0 Тогда
		ДанныеНечеткогоПоиска = ПодобратьПохожиеФамилии(Кандидаты, ИскомаяФамилия);
		ФизическиеЛица = ДанныеНечеткогоПоиска.ФизическиеЛица;
		Результат.НечеткийПоиск = ФизическиеЛица.Количество() > 0;
		Результат.НайденнаяФамилия = ДанныеНечеткогоПоиска.НайденнаяФамилия;
	КонецЕсли;
	Если ФизическиеЛица.Количество() > 0 Тогда
		Результат.Сотрудники = ПолучитьДанныеСотрудников(ФизическиеЛица);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьКандидатовПоиска()
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ФизическиеЛица.ФИО КАК ФИО
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО Сотрудники.ФизическоеЛицо = ФизическиеЛица.Ссылка
		|ГДЕ
		|	НЕ Сотрудники.ПометкаУдаления
		|	И НЕ ФизическиеЛица.ПометкаУдаления
		|	И Сотрудники.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		|	И ФизическиеЛица.ФИО <> """"";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПодобратьПохожиеФамилии(Знач Кандидаты, Знач ИскомаяФамилия)
	МинимальноеРасстояние = Неопределено;
	ДопустимоеРасстояние = ДопустимоеРасстояниеРедактирования(СтрДлина(ИскомаяФамилия));
	ПодходящиеФамилии = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		ФамилияКандидата = НормализованнаяФамилия(ФамилияИзФИО(Кандидат.ФИО));
		Если ПустаяСтрока(ФамилияКандидата) Тогда
			Продолжить;
		КонецЕсли;
		Расстояние = РасстояниеРедактирования(ИскомаяФамилия, ФамилияКандидата);
		Если Расстояние > ДопустимоеРасстояние Тогда
			Продолжить;
		КонецЕсли;
		Если МинимальноеРасстояние = Неопределено Или Расстояние < МинимальноеРасстояние Тогда
			МинимальноеРасстояние = Расстояние;
			ПодходящиеФамилии.Очистить();
		КонецЕсли;
		Если Расстояние = МинимальноеРасстояние Тогда
			ПодходящиеФамилии.Вставить(ФамилияКандидата, Истина);
		КонецЕсли;
	КонецЦикла;
	ФизическиеЛица = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		ФамилияКандидата = НормализованнаяФамилия(ФамилияИзФИО(Кандидат.ФИО));
		Если ПодходящиеФамилии.Получить(ФамилияКандидата) <> Неопределено Тогда
			ФизическиеЛица.Добавить(Кандидат.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	НайденныеФамилии = Новый Массив;
	Для Каждого ЭлементСоответствия Из ПодходящиеФамилии Цикл
		НайденныеФамилии.Добавить(ЭлементСоответствия.Ключ);
	КонецЦикла;
	Возврат Новый Структура(
		"ФизическиеЛица, НайденнаяФамилия", ФизическиеЛица, СтрСоединить(НайденныеФамилии, ", "));
КонецФункции

Функция ПолучитьДанныеСотрудников(Знач ФизическиеЛица)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	ФизическиеЛица.ФИО КАК ФИО,
		|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
		|	ЕСТЬNULL(КадроваяИстория.ДолжностьПоШтатномуРасписанию.Должность,
		|		ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность,
		|	ЕСТЬNULL(ТекущиеКадровыеДанные.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУвольнения
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО Сотрудники.ФизическоеЛицо = ФизическиеЛица.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанные
		|		ПО Сотрудники.Ссылка = ТекущиеКадровыеДанные.Сотрудник
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(
		|				, Сотрудник.ФизическоеЛицо В (&ФизическиеЛица)) КАК КадроваяИстория
		|		ПО Сотрудники.Ссылка = КадроваяИстория.Сотрудник
		|ГДЕ
		|	Сотрудники.ФизическоеЛицо В(&ФизическиеЛица)
		|	И НЕ Сотрудники.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФИО,
		|	Сотрудник";
	Запрос.УстановитьПараметр("ФизическиеЛица", ФизическиеЛица);
	ТаблицаСотрудников = Запрос.Выполнить().Выгрузить();
	Результат = Новый Массив;
	Для Каждого СтрокаСотрудника Из ТаблицаСотрудников Цикл
		ДатаУвольнения = СтрокаСотрудника.ДатаУвольнения;
		СотрудникРаботает = ДатаУвольнения = '00010101'
			Или ДатаУвольнения >= НачалоДня(ТекущаяДатаСеанса());
		Статус = ?(СотрудникРаботает, "работает", "уволен");
		ДанныеСотрудника = Новый Структура(
			"Сотрудник, ФИО, ДатаРождения, Должность, Статус, ДатаУвольнения");
		ЗаполнитьЗначенияСвойств(ДанныеСотрудника, СтрокаСотрудника);
		ДанныеСотрудника.Статус = Статус;
		Результат.Добавить(ДанныеСотрудника);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ФамилияИзФИО(Знач ФИО)
	ЧастиФИО = СтрРазделить(СокрЛП(ФИО), " ", Ложь);
	Возврат ?(ЧастиФИО.Количество() = 0, "", ЧастиФИО[0]);
КонецФункции

Функция НормализованнаяФамилия(Знач Фамилия)
	Результат = ВРег(СокрЛП(Строка(Фамилия)));
	Возврат СтрЗаменить(Результат, "Ё", "Е");
КонецФункции

Функция ДопустимоеРасстояниеРедактирования(Знач ДлинаСтроки)
	Если ДлинаСтроки <= 4 Тогда
		Возврат 1;
	ИначеЕсли ДлинаСтроки <= 8 Тогда
		Возврат 2;
	КонецЕсли;
	Возврат 3;
КонецФункции

Функция РасстояниеРедактирования(Знач Строка1, Знач Строка2)
	Длина1 = СтрДлина(Строка1);
	Длина2 = СтрДлина(Строка2);
	ПредыдущаяСтрока = Новый Массив;
	Для Индекс = 0 По Длина2 Цикл
		ПредыдущаяСтрока.Добавить(Индекс);
	КонецЦикла;
	Для Индекс1 = 1 По Длина1 Цикл
		ТекущаяСтрока = Новый Массив;
		ТекущаяСтрока.Добавить(Индекс1);
		Для Индекс2 = 1 По Длина2 Цикл
			СтоимостьЗамены = ?(
				Сред(Строка1, Индекс1, 1) = Сред(Строка2, Индекс2, 1), 0, 1);
			Удаление = ПредыдущаяСтрока[Индекс2] + 1;
			Вставка = ТекущаяСтрока[Индекс2 - 1] + 1;
			Замена = ПредыдущаяСтрока[Индекс2 - 1] + СтоимостьЗамены;
			ТекущаяСтрока.Добавить(МинимумИзТрех(Удаление, Вставка, Замена));
		КонецЦикла;
		ПредыдущаяСтрока = ТекущаяСтрока;
	КонецЦикла;
	Возврат ПредыдущаяСтрока[Длина2];
КонецФункции

Функция МинимумИзТрех(Знач Значение1, Знач Значение2, Знач Значение3)
	Минимум = ?(Значение1 < Значение2, Значение1, Значение2);
	Возврат ?(Минимум < Значение3, Минимум, Значение3);
КонецФункции

#КонецОбласти
