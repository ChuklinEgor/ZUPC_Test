&НаСервере
Процедура ЗаполнитьФизЛицИзТабДокНаСервере()
	КолСтр = ФЛ.ВысотаТаблицы;
	Для Стр = 1 По КолСтр Цикл
		Отбор = Новый Структура();
		ФЛстр = СокрЛП(ФЛ.ПолучитьОбласть("R" + Стр + "C" + 1).ТекущаяОбласть.Текст);

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ФизическиеЛица.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ФизическиеЛица КАК ФизическиеЛица
			|ГДЕ
			|	ФизическиеЛица.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", ФЛстр);
		ВыборкаФЛ = Запрос.Выполнить().Выбрать();

		//Отбор.Вставить("Наименование", ФЛстр);
		//ВыборкаФЛ = Справочники.ФизическиеЛица.Выбрать(,,Отбор);
		Если ВыборкаФЛ.Количество()=0 Тогда
			Сообщить("Не найдено физическое лицо: "+ФЛстр);
	    	НовСтр = Физлица.Добавить();
		ИначеЕсли ВыборкаФЛ.Количество()=1 Тогда
			ВыборкаФЛ.Следующий();
	    	НовСтр = Физлица.Добавить();
			НовСтр.Значение = ВыборкаФЛ.Ссылка;
			НовСтр.Пометка = Истина;
		Иначе
			Сообщить("Найдено несколько физических лиц: "+ФЛстр);
			Пока ВыборкаФЛ.Следующий() Цикл
		    	НовСтр = Физлица.Добавить();
				НовСтр.Значение = ВыборкаФЛ.Ссылка;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФизЛицИзТабДок(Команда)
	ЗаполнитьФизЛицИзТабДокНаСервере();
КонецПроцедуры


