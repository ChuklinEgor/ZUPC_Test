Процедура ЗаполнитьВсемиОрганизациямиНаСервере()
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПереносДанных.Ссылка КАК Ссылка,
		|	ПереносДанных.Организация КАК Организация
		|ПОМЕСТИТЬ ВТ_ПереносыДанных
		|ИЗ
		|	Документ.ПереносДанных КАК ПереносДанных
		|ГДЕ
		|	НЕ ПереносДанных.ПометкаУдаления
		|	И ПереносДанных.ПериодРегистрации = &ПериодРегистрации
		|	И ПереносДанных.Номер ПОДОБНО ""ЗакрОст"" + ""%""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Организации.Ссылка КАК Организация,
		|	СУММА(1) КАК Счетчик
		|ПОМЕСТИТЬ ВТ_Выборка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ПереносыДанных КАК ВТ_ПереносыДанных
		|		ПО Организации.Ссылка = ВТ_ПереносыДанных.Организация
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления
