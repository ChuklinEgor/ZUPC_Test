Процедура ЗакрытьБухгалтерискиеВзаиморасчеты(Орг,Док, КопировитьИзВзаиморасчетов = Ложь) 
	Дата = Док.ПериодРегистрации;

	Если Док.ТаблицаРегистров.Найти("БухгалтерскиеВзаиморасчетыССотрудниками", "Имя") = Неопределено Тогда
		НоваяСтрока = Док.ТаблицаРегистров.Добавить();
		НоваяСтрока.Имя = "БухгалтерскиеВзаиморасчетыССотрудниками";
		//НоваяСтрока.Представление = "Взаиморасчеты с сотрудниками";
		
		Док.ТаблицаРегистров.Сортировать("Имя ВОЗР");
	КонецЕсли;
	
	НаборТекущегоОбъекта = Док.Движения["БухгалтерскиеВзаиморасчетыССотрудниками"];
	НаборТекущегоОбъекта.Очистить();
	Док.Записать();
	
	Если КопировитьИзВзаиморасчетов Тогда

		НаборТекущегоОбъекта0 = Док.Движения["ВзаиморасчетыССотрудниками"];
		НаборТекущегоОбъекта0.Прочитать();
		Для Каждого Движение Из НаборТекущегоОбъекта0 Цикл
			НоваяЗапись = НаборТекущегоОбъекта.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,Движение);
		КонецЦикла;
		Док.Записать();
		Возврат;
	КонецЕсли;
	
	Запрос2 = Новый Запрос();
	
	Запрос2.УстановитьПараметр("Дата",				КонецМесяца(Дата) + 1);
	Запрос2.УстановитьПараметр("Орг",				Орг);

	Запрос2.Текст =
	"ВЫБРАТЬ
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.СтатьяФинансирования КАК СтатьяФинансирования,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.СтатьяРасходов КАК СтатьяРасходов,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.Сотрудник КАК Сотрудник,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.Подразделение КАК Подразделение,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.СуммаВзаиморасчетовОстаток КАК СуммаВзаиморасчетовОстаток
	|ИЗ
	|	РегистрНакопления.БухгалтерскиеВзаиморасчетыССотрудниками.Остатки(&Дата, Организация = &Орг) КАК БухгалтерскиеВзаиморасчетыССотрудникамиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.СтатьяФинансирования,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.ФизическоеЛицо,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.СтатьяРасходов,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.Сотрудник,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.Подразделение,
	|	БухгалтерскиеВзаиморасчетыССотрудникамиОстатки.СуммаВзаиморасчетовОстаток
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицо
	|АВТОУПОРЯДОЧИВАНИЕ";
	
    //АС_ 2022-01-29
	Если ОтбиратьПоСтатьямРасходов Тогда
		Запрос2.УстановитьПараметр("СтатьиРасходов",				СтатьиРасходов);
		Запрос2.Текст = СтрЗаменить(Запрос2.Текст, "Организация = &Орг","Организация = &Орг И СтатьяРасходов В (&СтатьиРасходов)");
	КонецЕсли;
		
	Если ОтбиратьПоСтатьямФинансирования Тогда
		Запрос2.УстановитьПараметр("СтатьиФинансирования",				СтатьиФинансирования);
		Запрос2.Текст = СтрЗаменить(Запрос2.Текст, "Организация = &Орг","Организация = &Орг И СтатьяФинансирования В (&СтатьиФинансирования)");
	КонецЕсли;
	//***

	ФизлицаСПометками = ФизлицаСПометками();
	Если НЕ ФизлицаСПометками.Количество() = 0 Тогда
		Запрос2.УстановитьПараметр("Физлица",				ФизлицаСПометками);
		Запрос2.Текст = СтрЗаменить(Запрос2.Текст, "Организация = &Орг","Организация = &Орг И ФизическоеЛицо В (&Физлица)");
	КонецЕсли;
		
	Выборка2 = Запрос2.Выполнить().Выбрать();	
	
	Пока Выборка2.Следующий() Цикл
		
		НоваяЗапись = НаборТекущегоОбъекта.Добавить();
		НоваяЗапись.Активность  = Истина;
		НоваяЗапись.Сотрудник  = Выборка2.Сотрудник;
		НоваяЗапись.Подразделение  = Выборка2.Подразделение;
		НоваяЗапись.Период   = Дата;
		НоваяЗапись.ФизическоеЛицо = Выборка2.ФизическоеЛицо;
		НоваяЗапись.СуммаВзаиморасчетов = - Выборка2.СуммаВзаиморасчетовОстаток;
		НоваяЗапись.Организация = Орг;
		НоваяЗапись.СтатьяФинансирования = Выборка2.СтатьяФинансирования;
		НоваяЗапись.СтатьяРасходов = Выборка2.СтатьяРасходов;
		
	КонецЦикла; 
	Док.Записать();

КонецПроцедуры

