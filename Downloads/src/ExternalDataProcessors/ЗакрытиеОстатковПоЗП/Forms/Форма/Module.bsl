&НаСервере
Функция ВыполнитьНаСервере(Орг,Док,Комментарий="")
	Если  Орг = Справочники.Организации.ПустаяСсылка() Тогда
		Сообщить("Не указана организация");
		Возврат Ложь;
	КонецЕсли;	
	Если  Док = Документы.ПереносДанных.ПустаяСсылка() Тогда
		Док = Документы.ПереносДанных.СоздатьДокумент();
		Док.ПериодРегистрации = Объект.ПериодРегистрации;
		Док.Дата = КонецМесяца(Объект.ПериодРегистрации);
		Док.Организация = Орг;
		Док.Номер = "ЗакрОст";
		Если Объект.ЗакрыватьЗарплатуКВыплате Тогда
			Регистр = Док.ТаблицаРегистров.Добавить();
			Регистр.Имя = "ЗарплатаКВыплате";
		КонецЕсли;	
		Если Объект.ЗакрыватьВзаиморасчетыССотрудниками Тогда
			Регистр = Док.ТаблицаРегистров.Добавить();
			Регистр.Имя = "ВзаиморасчетыССотрудниками";
		КонецЕсли;
		Если Объект.ЗакрыватьБухгалтерскиеВзаиморасчетыССотрудниками Тогда
			Регистр = Док.ТаблицаРегистров.Добавить();
			Регистр.Имя = "БухгалтерскиеВзаиморасчетыССотрудниками";
		КонецЕсли;
		Если Объект.ЗакрыватьРасчетыНалогоплательщиковСБюджетомПоНДФЛ Тогда
			Регистр = Док.ТаблицаРегистров.Добавить();
			Регистр.Имя = "РасчетыНалогоплательщиковСБюджетомПоНДФЛ";
		КонецЕсли;
		Если Объект.ЗакрыватьРасчетыНалоговыхАгентовСБюджетомПоНДФЛ Тогда
			Регистр = Док.ТаблицаРегистров.Добавить();
			Регистр.Имя = "ЗакрыватьРасчетыНалоговыхАгентовСБюджетомПоНДФЛ";
		КонецЕсли;
	Иначе
		Если  НЕ Орг = Док.Организация Тогда
			Комментарий = "Не совпадает организация с организацией указанной в документе"+Док.Организация;
			Сообщить("Не совпадает организация "+Орг+" с организацией указанной в документе"+Док.Организация);
			Возврат Ложь;
		КонецЕсли;	
		Если  НЕ Объект.ПериодРегистрации = Док.ПериодРегистрации Тогда
			Комментарий = "Не совпадает ПериодРегистрации "+Орг+" с периодом указанным в документе"+Док.ПериодРегистрации;
			Сообщить("Не совпадает ПериодРегистрации с периодом указанным в документе"+Док.ПериодРегистрации);
			Возврат Ложь;
		КонецЕсли;	
		Если  НЕ Лев(Док.Номер,7) = "ЗакрОст" Тогда
			Комментарий = "Номер указанный в документе "+Док.Номер+ " должен начинаться с ""ЗакрОст""";
			Сообщить("Для "+Орг+" номер указанный в документе "+Док.Номер+ " должен начинаться с ""ЗакрОст""");
			Возврат Ложь;
		КонецЕсли;	
		
		Док = Док.ПолучитьОбъект();
		//Док.Дата = КонецМесяца(Объект.ПериодРегистрации);
		//Очистим регистры
		Если Объект.ЗакрыватьЗарплатуКВыплате И НЕ Док.Движения.Найти("ЗарплатаКВыплате")=Неопределено Тогда
			Движение = Док.Движения.ЗарплатаКВыплате;	
			Движение.Прочитать();	
			Движение.Очистить();	
			Движение.Записать();
		КонецЕсли;	
		Если Объект.ЗакрыватьВзаиморасчетыССотрудниками И НЕ Док.Движения.Найти("ВзаиморасчетыССотрудниками")=Неопределено Тогда
			Движение = Док.Движения.ВзаиморасчетыССотрудниками;	
			Движение.Прочитать();	
			Движение.Очистить();	
			Движение.Записать();
		КонецЕсли;
		Если Объект.ЗакрыватьБухгалтерскиеВзаиморасчетыССотрудниками И НЕ Док.Движения.Найти("БухгалтерскиеВзаиморасчетыССотрудниками")=Неопределено Тогда
			Движение = Док.Движения.БухгалтерскиеВзаиморасчетыССотрудниками;	
			Движение.Прочитать();	
			Движение.Очистить();	
			Движение.Записать();
		КонецЕсли;
		Если Объект.ЗакрыватьРасчетыНалоговыхАгентовСБюджетомПоНДФЛ И НЕ Док.Движения.Найти("РасчетыНалоговыхАгентовСБюджетомПоНДФЛ")=Неопределено Тогда
			Движение = Док.Движения.РасчетыНалоговыхАгентовСБюджетомПоНДФЛ;	
			Движение.Прочитать();	
			Движение.Очистить();	
			Движение.Записать();
		КонецЕсли;
		Если Объект.ЗакрыватьРасчетыНалогоплательщиковСБюджетомПоНДФЛ И НЕ Док.Движения.Найти("РасчетыНалогоплательщиковСБюджетомПоНДФЛ")=Неопределено Тогда
			Движение = Док.Движения.РасчетыНалогоплательщиковСБюджетомПоНДФЛ;	
			Движение.Прочитать();	
			Движение.Очистить();	
			Движение.Записать();
		КонецЕсли;
	КонецЕсли;	
	Док.Записать();
	
	Если Объект.ЗакрыватьЗарплатуКВыплате Тогда
		ЗакрытьЗПКВыплате(Орг,Док);
	КонецЕсли;	
	
	Если Объект.ЗакрыватьВзаиморасчетыССотрудниками Тогда
		ЗакрытьВзаиморасчеты(Орг,Док);
	КонецЕсли;
	
	Если Объект.ЗакрыватьБухгалтерскиеВзаиморасчетыССотрудниками Тогда
		ЗакрытьБухгалтерискиеВзаиморасчеты(Орг,Док, Ложь);
	КонецЕсли;
	
	Если Объект.СкопироватьВзаиморасчетыВБухгалтерскиеВзаиморасчеты Тогда
		ЗакрытьБухгалтерискиеВзаиморасчеты(Орг,Док, Истина)
	КонецЕсли;
	
	Если Объект.ЗакрыватьРасчетыНалоговыхАгентовСБюджетомПоНДФЛ Тогда
		ЗакрытьРасчетыНалоговыхАгентовСБюджетомПоНДФЛ(Орг,Док);
	КонецЕсли;
	
	Если Объект.ЗакрыватьРасчетыНалогоплательщиковСБюджетомПоНДФЛ Тогда
		ЗакрытьРасчетыНалогоплательщиковСБюджетомПоНДФЛ(Орг,Док);
	КонецЕсли;
	Комментарий = "Обработано " + ТекущаяДата();
	Док = Док.Ссылка;
	Возврат Истина;
КонецФункции

Процедура ЗакрытьЗПКВыплате(Орг,Док) 
	
	
	Дата = Док.ПериодРегистрации;
	
	Если Док.ТаблицаРегистров.Найти("ЗарплатаКВыплате", "Имя") = Неопределено Тогда
		НоваяСтрока = Док.ТаблицаРегистров.Добавить();
		НоваяСтрока.Имя = "ЗарплатаКВыплате";
		//НоваяСтрока.Представление = "Зарплата к выплате";
		
		Док.ТаблицаРегистров.Сортировать("Имя ВОЗР");
	КонецЕсли;
	
	НаборТекущегоОбъекта2 = Док.Движения["ЗарплатаКВыплате"];
	НаборТекущегоОбъекта2.Очистить();
	Док.Записать();
	
	Запрос = Новый Запрос();
	
	Запрос.УстановитьПараметр("Дата",				КонецМесяца(Дата) + 1);
	Запрос.УстановитьПараметр("Орг",				Орг);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗарплатаКВыплатеОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗарплатаКВыплатеОстатки.Сотрудник КАК Сотрудник,
	|	ЗарплатаКВыплатеОстатки.Подразделение КАК Подразделение,
	|	ЗарплатаКВыплатеОстатки.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ЗарплатаКВыплатеОстатки.СуммаКВыплатеОстаток КАК СуммаКВыплатеОстаток,
	|	ЗарплатаКВыплатеОстатки.СтатьяФинансирования КАК СтатьяФинансирования,
	|	ЗарплатаКВыплатеОстатки.СтатьяРасходов КАК СтатьяРасходов,
	|	ЗарплатаКВыплатеОстатки.ВидДоходаИсполнительногоПроизводства КАК ВидДоходаИсполнительногоПроизводства,
	|	ЗарплатаКВыплатеОстатки.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	РегистрНакопления.ЗарплатаКВыплате.Остатки(&Дата, Организация = &Орг) КАК ЗарплатаКВыплатеОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗарплатаКВыплатеОстатки.Сотрудник,
	|	ЗарплатаКВыплатеОстатки.ФизическоеЛицо,
	|	ЗарплатаКВыплатеОстатки.Подразделение,
	|	ЗарплатаКВыплатеОстатки.ПериодВзаиморасчетов,
	|	ЗарплатаКВыплатеОстатки.СуммаКВыплатеОстаток,
	|	ЗарплатаКВыплатеОстатки.СтатьяФинансирования,
	|	ЗарплатаКВыплатеОстатки.СтатьяРасходов,
	|	ЗарплатаКВыплатеОстатки.ВидДоходаИсполнительногоПроизводства,
	|	ЗарплатаКВыплатеОстатки.ДокументОснование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицо
	|АВТОУПОРЯДОЧИВАНИЕ";
	
    //АС_ 2022-01-29
	Если ОтбиратьПоСтатьямРасходов Тогда
		Запрос.УстановитьПараметр("СтатьиРасходов",				СтатьиРасходов);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Орг","Организация = &Орг И СтатьяРасходов В (&СтатьиРасходов)");
	КонецЕсли;
		
	Если ОтбиратьПоСтатьямФинансирования Тогда
		Запрос.УстановитьПараметр("СтатьиФинансирования",				СтатьиФинансирования);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Орг","Организация = &Орг И СтатьяФинансирования В (&СтатьиФинансирования)");
	КонецЕсли;
	//***

	ФизлицаСПометками = ФизлицаСПометками();
	Если НЕ ФизлицаСПометками.Количество() = 0 Тогда
		Запрос.УстановитьПараметр("Физлица",				ФизлицаСПометками);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Орг","Организация = &Орг И ФизическоеЛицо В (&Физлица)");
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Пока Выборка.Следующий() Цикл
		
		НоваяЗапись = НаборТекущегоОбъекта2.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись,Выборка);
		НоваяЗапись.Активность  = Истина;
		НоваяЗапись.Период   = Дата;
		НоваяЗапись.Организация = Орг;
		НоваяЗапись.СуммаКВыплате = - Выборка.СуммаКВыплатеОстаток;
		
		//НоваяЗапись.Сотрудник  = Выборка.Сотрудник;
		//НоваяЗапись.Подразделение  = Выборка.Подразделение;
		//НоваяЗапись.ПериодВзаиморасчетов  = Выборка.ПериодВзаиморасчетов;
		//НоваяЗапись.ФизическоеЛицо = Выборка.ФизическоеЛицо;
		//НоваяЗапись.СтатьяФинансирования = Выборка.СтатьяФинансирования;
		//НоваяЗапись.СтатьяРасходов = Выборка.СтатьяРасходов;
		
	КонецЦикла;
	Док.Записать();

КонецПроцедуры

Процедура ЗакрытьВзаиморасчеты(Орг,Док) 
	Дата = Док.ПериодРегистрации;

	Если Док.ТаблицаРегистров.Найти("ВзаиморасчетыССотрудниками", "Имя") = Неопределено Тогда
		НоваяСтрока = Док.ТаблицаРегистров.Добавить();
		НоваяСтрока.Имя = "ВзаиморасчетыССотрудниками";
		//НоваяСтрока.Представление = "Взаиморасчеты с сотрудниками";
		
		Док.ТаблицаРегистров.Сортировать("Имя ВОЗР");
	КонецЕсли;
	
	НаборТекущегоОбъекта = Док.Движения["ВзаиморасчетыССотрудниками"];
	НаборТекущегоОбъекта.Очистить();
	Док.Записать();
	
	Запрос2 = Новый Запрос();
	
	Запрос2.УстановитьПараметр("Дата",				КонецМесяца(Дата) + 1);
	Запрос2.УстановитьПараметр("Орг",				Орг);

	Запрос2.Текст =
	"ВЫБРАТЬ
	|	ВзаиморасчетыССотрудникамиОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВзаиморасчетыССотрудникамиОстатки.СтатьяФинансирования КАК СтатьяФинансирования,
	|	ВзаиморасчетыССотрудникамиОстатки.СтатьяРасходов КАК СтатьяРасходов,
	|	ВзаиморасчетыССотрудникамиОстатки.Сотрудник КАК Сотрудник,
	|	ВзаиморасчетыССотрудникамиОстатки.Подразделение КАК Подразделение,
	|	ВзаиморасчетыССотрудникамиОстатки.СуммаВзаиморасчетовОстаток КАК СуммаВзаиморасчетовОстаток
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыССотрудниками.Остатки(&Дата, Организация = &Орг) КАК ВзаиморасчетыССотрудникамиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыССотрудникамиОстатки.СтатьяФинансирования,
	|	ВзаиморасчетыССотрудникамиОстатки.ФизическоеЛицо,
	|	ВзаиморасчетыССотрудникамиОстатки.СтатьяРасходов,
	|	ВзаиморасчетыССотрудникамиОстатки.Сотрудник,
	|	ВзаиморасчетыССотрудникамиОстатки.Подразделение,
	|	ВзаиморасчетыССотрудникамиОстатки.СуммаВзаиморасчетовОстаток
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизическоеЛицо
	|АВТОУПОРЯДОЧИВАНИЕ";
	
    //АС_ 2022-01-29
	Если ОтбиратьПоСтатьямРасходов Тогда
		Запрос2.УстановитьПараметр("СтатьиРасходов",				СтатьиРасходов);
		Запрос2.Текст = СтрЗаменить(Запрос2.Текст, "Организация = &Орг","Организация = &Орг И СтатьяРасходов В (&СтатьиРасходов)");
	КонецЕсли;
		
	Если ОтбиратьПоСтатьямФинансирования Тогда
		Запрос2.УстановитьПараметр("СтатьиФинансирования",				СтатьиФинансирования);
		Запрос2.Текст = СтрЗаменить(Запрос2.Текст, "Организация = &Орг","Организация = &Орг И СтатьяФинансирования В (&СтатьиФинансирования)");
	КонецЕсли;
	//***

	ФизлицаСПометками = ФизлицаСПометками();
	Если НЕ ФизлицаСПометками.Количество() = 0 Тогда
		Запрос2.УстановитьПараметр("Физлица",				ФизлицаСПометками);
		Запрос2.Текст = СтрЗаменить(Запрос2.Текст, "Организация = &Орг","Организация = &Орг И ФизическоеЛицо В (&Физлица)");
	КонецЕсли;
		
	Выборка2 = Запрос2.Выполнить().Выбрать();	
	
	Пока Выборка2.Следующий() Цикл
		
		НоваяЗапись = НаборТекущегоОбъекта.Добавить();
		НоваяЗапись.Активность  = Истина;
		НоваяЗапись.Сотрудник  = Выборка2.Сотрудник;
		НоваяЗапись.Подразделение  = Выборка2.Подразделение;
		НоваяЗапись.Период   = Дата;
		НоваяЗапись.ФизическоеЛицо = Выборка2.ФизическоеЛицо;
		НоваяЗапись.СуммаВзаиморасчетов = - Выборка2.СуммаВзаиморасчетовОстаток;
		НоваяЗапись.Организация = Орг;
		НоваяЗапись.СтатьяФинансирования = Выборка2.СтатьяФинансирования;
		НоваяЗапись.СтатьяРасходов = Выборка2.СтатьяРасходов;
		
